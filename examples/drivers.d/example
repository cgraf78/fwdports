#!/usr/bin/env bash
# Minimal harmless ABI-v1 driver.  It opens no network connection; `run` stays
# in the foreground until stopped so it can be used to inspect lifecycle
# behavior on a copied example profile.

set -u

operation=${1:-}
shift || true
case "$operation" in
  api-version)
    [[ $# -eq 0 ]] || exit 64
    printf '1\n'
    ;;
  validate | prepare | cleanup)
    [[ $# -ge 3 && $# -le 4 ]] || exit 64
    ;;
  run)
    [[ $# -eq 3 ]] || exit 64
    trap 'exit 0' HUP INT TERM
    while :; do sleep 1; done
    ;;
  is-live)
    [[ $# -eq 4 ]] || exit 64
    # This example has no protocol-specific observation.  Exit two asks core
    # to rely on its authenticated tmux/process evidence.
    exit 2
    ;;
  *) exit 64 ;;
esac

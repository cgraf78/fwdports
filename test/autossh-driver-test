#!/usr/bin/env bash
# Explicit autossh resolution and launch-environment tests.
# Named cases and TEST_CASE are consumed indirectly by the shared harness.
# shellcheck disable=SC2329,SC2016,SC2034

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
RUNNER=$ROOT/lib/fwdports/builtin-runner.sh
TEST_CASE=${1:-}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"
# shellcheck source=../lib/fwdports/drivers.sh
source "$ROOT/lib/fwdports/drivers.sh"

explicit_only_case() {
  local tmp empty_path output status
  tmp=$(_tmpdir) || return 1
  empty_path=$tmp/bin
  output=$tmp/identity
  mkdir -p "$empty_path"
  set +e
  PATH=$empty_path fwdports_autossh_resolve autossh "$output" \
    >/dev/null 2>&1
  status=$?
  _assert_exit "autossh: selected dependency must exist" 1 "$status"
  _assert_not_exists "autossh: failed resolution publishes nothing" "$output"
}

sanitized_environment_case() {
  local tmp runtime fake output status content
  tmp=$(_tmpdir) || return 1
  runtime=$tmp/runtime
  fake=$tmp/autossh
  output=$tmp/output
  mkdir -p "$runtime"
  chmod 0700 "$runtime"
  printf '%s\n' autossh >"$runtime/driver-kind"
  printf '%s\n' shell.example.com >"$runtime/ssh-target"
  printf '%s\n' -N -T >"$runtime/ssh-argv"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$runtime/ssh-gate"
  chmod 0700 "$runtime/ssh-gate"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "gate=%s port=%s path=%s\n" "$AUTOSSH_GATETIME" "$AUTOSSH_PORT" "$AUTOSSH_PATH"' \
    'printf "maxstart=%s pidfile=%s debug=%s\n" "${AUTOSSH_MAXSTART-unset}" "${AUTOSSH_PIDFILE-unset}" "${AUTOSSH_DEBUG-unset}"' \
    'printf "argv"; printf " <%s>" "$@"; printf "\n"' >"$fake"
  chmod 0700 "$fake"
  printf 'path\t%s\nversion\tautossh test\n' "$fake" \
    >"$runtime/autossh-source"

  set +e
  AUTOSSH_MAXSTART=9 AUTOSSH_PIDFILE=$tmp/pid AUTOSSH_DEBUG=1 \
    "$RUNNER" "$runtime" >"$output" 2>&1
  status=$?
  content=$(<"$output")
  _assert_exit "autossh: foreground launcher succeeds" 0 "$status"
  _assert_contains "autossh: disables startup gate and monitor port" \
    "gate=0 port=0" "$content"
  _assert_contains "autossh: routes every child through SSH gate" \
    "path=$runtime/ssh-gate" "$content"
  _assert_contains "autossh: removes ambient retry controls" \
    "maxstart=unset pidfile=unset debug=unset" "$content"
  _assert_contains "autossh: launches in foreground with distinct argv" \
    "argv <-M> <0> <-N> <-T> <shell.example.com>" "$content"
}

hup_reaping_case() {
  local tmp runtime fake child_pid_file term_marker runner_pid child_pid=''
  local index=0 alive=1 status=0
  tmp=$(_tmpdir) || return 1
  runtime=$tmp/runtime
  fake=$tmp/autossh
  child_pid_file=$tmp/autossh.pid
  term_marker=$tmp/autossh.term
  mkdir -p "$runtime"
  chmod 0700 "$runtime"
  printf '%s\n' autossh >"$runtime/driver-kind"
  printf '%s\n' shell.example.com >"$runtime/ssh-target"
  printf '%s\n' -N -T >"$runtime/ssh-argv"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$runtime/ssh-gate"
  chmod 0700 "$runtime/ssh-gate"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'trap "" HUP' \
    'trap '\''printf "term\n" >"$FWDPORTS_TEST_TERM_MARKER"; exit 0'\'' TERM' \
    'printf "%s\n" "$$" >"$FWDPORTS_TEST_CHILD_PID"' \
    'while :; do sleep 0.02; done' \
    >"$fake"
  chmod 0700 "$fake"
  printf 'path\t%s\nversion\tautossh test\n' "$fake" \
    >"$runtime/autossh-source"

  FWDPORTS_TEST_CHILD_PID=$child_pid_file \
    FWDPORTS_TEST_TERM_MARKER=$term_marker \
    "$RUNNER" "$runtime" >/dev/null 2>&1 &
  runner_pid=$!
  while [[ ! -s $child_pid_file && $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  [[ ! -s $child_pid_file ]] || child_pid=$(<"$child_pid_file")
  kill -HUP "$runner_pid" 2>/dev/null || true
  index=0
  while kill -0 "$runner_pid" 2>/dev/null && [[ $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  if ! kill -0 "$runner_pid" 2>/dev/null; then
    alive=0
  else
    kill -TERM "$runner_pid" 2>/dev/null || true
  fi
  wait "$runner_pid" 2>/dev/null || status=$?

  _assert_eq "autossh rollback: HUP exits the wrapper" 0 "$alive"
  _assert_exit "autossh rollback: preserves HUP status" 129 "$status"
  _assert_file "autossh rollback: converts HUP to child TERM" "$term_marker"
  if [[ -n $child_pid ]] && ! kill -0 "$child_pid" 2>/dev/null; then
    _pass "autossh rollback: reaps the HUP-insensitive child"
  else
    _fail "autossh rollback: reaps the HUP-insensitive child"
    [[ -z $child_pid ]] || kill -KILL "$child_pid" 2>/dev/null || true
  fi
}

run_case explicit-only explicit_only_case
run_case sanitized-environment sanitized_environment_case
run_case hup-reaping hup_reaping_case
_test_summary

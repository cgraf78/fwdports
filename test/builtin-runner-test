#!/usr/bin/env bash
# Built-in foreground wrapper retry and signal behavior.
# Named cases and TEST_CASE are consumed indirectly by the shared harness.
# shellcheck disable=SC2329,SC2016,SC2034

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
RUNNER=$ROOT/lib/fwdports/builtin-runner.sh
TEST_CASE=${1:-}
TMUX_BIN=${FWDPORTS_TEST_TMUX_BIN-$(command -v tmux)}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"

wait_for_lines() {
  local file=$1 expected=$2 index=0 count=0
  while [[ $index -lt 500 ]]; do
    [[ ! -f $file ]] || count=$(wc -l <"$file" | tr -d ' ')
    [[ $count -ge $expected ]] && return 0
    sleep 0.01
    index=$((index + 1))
  done
  return 1
}

setup_runtime() {
  local tmp=$1
  RUNTIME=$tmp/runtime
  CALLS=$tmp/calls
  mkdir -p "$RUNTIME"
  chmod 0700 "$RUNTIME"
  printf '%s\n' ssh >"$RUNTIME/driver-kind"
  printf '%s\n' shell.example.com >"$RUNTIME/ssh-target"
  printf '%s\n' -N >"$RUNTIME/ssh-argv"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "call\n" >>"$FWDPORTS_TEST_CALLS"' \
    'calls=$(wc -l <"$FWDPORTS_TEST_CALLS")' \
    '[[ $calls -gt 1 ]] || exit "${FWDPORTS_TEST_FIRST_STATUS:-1}"' \
    'trap "exit 0" TERM INT HUP' \
    'while :; do sleep 1; done' >"$RUNTIME/ssh-gate"
  chmod 0700 "$RUNTIME/ssh-gate"
}

retry_case() {
  local tmp pid index=0 alive=1
  tmp=$(_tmpdir) || return 1
  setup_runtime "$tmp"
  # The runner owns and reaps its direct child; this test does not need a new
  # session, and stock macOS intentionally ships no external `setsid` command.
  FWDPORTS_TEST_CALLS=$CALLS "$RUNNER" "$RUNTIME" &
  pid=$!
  if wait_for_lines "$CALLS" 2; then
    _pass "built-in SSH: retries after an early failure"
  else
    _fail "built-in SSH: retries after an early failure"
  fi
  kill -TERM "$pid" 2>/dev/null || true
  while [[ $index -lt 200 ]]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      alive=0
      break
    fi
    sleep 0.01
    index=$((index + 1))
  done
  wait "$pid" 2>/dev/null || true
  _assert_eq "built-in SSH: TERM reaps the wrapper" 0 "$alive"
}

drift_case() {
  local tmp status calls
  tmp=$(_tmpdir) || return 1
  setup_runtime "$tmp"
  set +e
  FWDPORTS_TEST_CALLS=$CALLS FWDPORTS_TEST_FIRST_STATUS=78 \
    "$RUNNER" "$RUNTIME"
  status=$?
  calls=$(wc -l <"$CALLS" | tr -d ' ')
  _assert_exit "built-in SSH: drift status is preserved" 78 "$status"
  _assert_eq "built-in SSH: drift is never retried" 1 "$calls"
}

et_no_retry_case() {
  local tmp runtime calls status count
  tmp=$(_tmpdir) || return 1
  runtime=$tmp/runtime
  calls=$tmp/calls
  mkdir -p "$runtime"
  chmod 0700 "$runtime"
  printf '%s\n' et >"$runtime/driver-kind"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "call\n" >>"$FWDPORTS_TEST_CALLS"' \
    'exit 23' >"$runtime/et-gate"
  chmod 0700 "$runtime/et-gate"

  set +e
  FWDPORTS_TEST_CALLS=$calls "$RUNNER" "$runtime"
  status=$?
  set -e
  count=$(wc -l <"$calls" | tr -d ' ')

  _assert_exit "built-in ET: foreground status is preserved" 23 "$status"
  _assert_eq "built-in ET: fwdports adds no retry loop" 1 "$count"
}

et_signal_case() {
  local tmp runtime pid_file term_marker runner_pid child_pid='' status index=0
  tmp=$(_tmpdir) || return 1
  runtime=$tmp/runtime
  pid_file=$tmp/et.pid
  term_marker=$tmp/et.term
  mkdir -p "$runtime"
  chmod 0700 "$runtime"
  printf '%s\n' et >"$runtime/driver-kind"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "$$" >"$FWDPORTS_TEST_ET_PID"' \
    'trap '\''printf "term\n" >"$FWDPORTS_TEST_ET_TERM"; exit 0'\'' TERM' \
    'trap "exit 0" HUP INT' \
    'while :; do sleep 0.02; done' >"$runtime/et-gate"
  chmod 0700 "$runtime/et-gate"

  FWDPORTS_TEST_ET_PID=$pid_file FWDPORTS_TEST_ET_TERM=$term_marker \
    "$RUNNER" "$runtime" &
  runner_pid=$!
  while [[ ! -s $pid_file && $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  [[ ! -s $pid_file ]] || child_pid=$(<"$pid_file")
  kill -HUP "$runner_pid" 2>/dev/null || true
  set +e
  wait "$runner_pid"
  status=$?
  set -e

  _assert_exit "built-in ET: tmux HUP preserves wrapper status" 129 "$status"
  _assert_file "built-in ET: tmux HUP becomes child TERM" "$term_marker"
  if [[ -n $child_pid ]] && ! kill -0 "$child_pid" 2>/dev/null; then
    _pass "built-in ET: signalled child is reaped"
  else
    _fail "built-in ET: signalled child is reaped"
    [[ -z $child_pid ]] || kill -KILL "$child_pid" 2>/dev/null || true
  fi
}

ettun_no_retry_case() {
  local tmp runtime calls status count
  tmp=$(_tmpdir) || return 1
  runtime=$tmp/runtime
  calls=$tmp/calls
  mkdir -p "$runtime"
  chmod 0700 "$runtime"
  printf '%s\n' ettun >"$runtime/driver-kind"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "call\n" >>"$FWDPORTS_TEST_CALLS"' \
    'exit 23' >"$runtime/ettun-gate"
  chmod 0700 "$runtime/ettun-gate"

  set +e
  FWDPORTS_TEST_CALLS=$calls "$RUNNER" "$runtime"
  status=$?
  set -e
  count=0
  [[ ! -f $calls ]] || count=$(wc -l <"$calls" | tr -d ' ')

  _assert_exit "built-in ettun: foreground status is preserved" 23 "$status"
  _assert_eq "built-in ettun: fwdports adds no retry loop" 1 "$count"
}

ettun_interactive_stdin_case() {
  local tmp runtime socket result ready output session pane expected actual
  local status index=0
  tmp=$(_tmpdir) || return 1
  runtime=$tmp/runtime
  socket=$tmp/tmux.sock
  result=$tmp/stdin.result
  ready=$tmp/stdin.ready
  mkdir -p "$runtime"
  chmod 0700 "$runtime"
  printf '%s\n' ettun >"$runtime/driver-kind"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'mode=pipe' \
    '[[ -t 0 ]] && mode=tty' \
    ': >"$FWDPORTS_TEST_STDIN_READY"' \
    'if ! IFS= read -r value; then' \
    '  printf "unexpected-eof\n" >"$FWDPORTS_TEST_STDIN_RESULT"' \
    '  exit 25' \
    'fi' \
    'printf "%s:%s\n" "$mode" "$value" >"$FWDPORTS_TEST_STDIN_RESULT"' \
    >"$runtime/ettun-gate"
  chmod 0700 "$runtime/ettun-gate"

  if [[ -n $TMUX_BIN ]]; then
    output=$(FWDPORTS_TEST_STDIN_RESULT=$result \
      FWDPORTS_TEST_STDIN_READY=$ready \
      "$TMUX_BIN" -S "$socket" -f /dev/null new-session -d -P \
      -F '#{session_id}:#{pane_id}' -- "$RUNNER" "$runtime") || return 1
    session=${output%%:*}
    pane=${output#*:}
    while [[ ! -e $ready && ! -e $result && $index -lt 200 ]]; do
      sleep 0.01
      index=$((index + 1))
    done
    if [[ -e $ready ]]; then
      "$TMUX_BIN" -S "$socket" send-keys -l -t "$pane" 'from-pane'
      "$TMUX_BIN" -S "$socket" send-keys -t "$pane" Enter
      index=0
      while [[ ! -e $result && $index -lt 200 ]]; do
        sleep 0.01
        index=$((index + 1))
      done
    fi
    "$TMUX_BIN" -S "$socket" kill-session -t "$session" 2>/dev/null || true
    expected=tty:from-pane
  else
    # The explicit stock macOS Bash job intentionally has no tmux. A pipe
    # still exercises Bash's asynchronous-command stdin replacement rule.
    printf '%s\n' from-stdin |
      FWDPORTS_TEST_STDIN_RESULT=$result \
        FWDPORTS_TEST_STDIN_READY=$ready \
        "$RUNNER" "$runtime"
    status=$?
    _assert_exit "built-in ettun: stdin fallback runner succeeds" 0 "$status"
    expected=pipe:from-stdin
  fi
  if [[ -r $result ]]; then
    actual=$(<"$result")
  else
    actual=missing
  fi

  _assert_eq "built-in ettun: preserves pane stdin for interactive transport" \
    "$expected" "$actual"
}

run_case retry retry_case
run_case drift drift_case
run_case et-no-retry et_no_retry_case
run_case et-signal et_signal_case
run_case ettun-no-retry ettun_no_retry_case
run_case ettun-interactive-stdin ettun_interactive_stdin_case
_test_summary

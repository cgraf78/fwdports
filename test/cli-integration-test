force_residual_listener_rebuilds_case() {
  local tmp config output listener_pid listener_ready probe_attempt
  local resolvable=0 probe_pids
  tmp=$(_tmpdir) || return 1
  setup_case_root "$tmp"
  config=$CASE_CONFIG/fwdports/tunnels.conf
  output=$tmp/output
  printf '%s\n' \
    'profile default' \
    'leg shell' \
    'set shell host shell.example.com' \
    'set shell local-forward 127.0.0.1:19233:127.0.0.1:9090' >"$config"
  chmod 0600 "$config"

  python3 -c "import socket, time
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(('127.0.0.1', 19233))
s.listen(1)
time.sleep(120)" &
  listener_pid=$!
  listener_ready=0
  probe_attempt=0
  while [[ $probe_attempt -lt 25 ]]; do
    if python3 -c "import socket, sys
s = socket.socket()
s.settimeout(0.2)
try:
    s.connect(('127.0.0.1', 19233))
except OSError:
    sys.exit(1)
" 2>/dev/null; then
      listener_ready=1
      break
    fi
    probe_attempt=$((probe_attempt + 1))
    sleep 0.2
  done
  if [[ $listener_ready -eq 1 ]] && kill -0 "$listener_pid" 2>/dev/null; then
    _pass "force residual listener: setup listener is live"
  else
    _fail "force residual listener: setup listener is live"
    return 1
  fi

  # Self-calibrating: probe real owner resolution on this platform. Where
  # no method can see the listener owner (e.g. Android /proc
  # restrictions), force must fail loudly without collateral damage
  # instead of reclaiming.
  probe_pids=$(bash -c 'source "$1";
    _fwdports_local_forward_listener_pids "$2"' _ \
    "$ROOT/lib/fwdports/drivers.sh" 19233 2>/dev/null)
  if [[ -n $probe_pids ]]; then
    resolvable=1
  elif [[ -r /proc/net/tcp ]]; then
    probe_pids=$(bash -c 'source "$1";
      _fwdports_local_forward_listener_pids_proc "$2"' _ \
      "$ROOT/lib/fwdports/drivers.sh" 19233 2>/dev/null)
    if [[ -n $probe_pids ]]; then
      resolvable=1
    fi
  fi

  run_fwdports "$output" start --force
  if [[ $resolvable -eq 1 ]]; then
    _assert_exit "force residual listener: rebuilds despite bound port" 0 \
      "$COMMAND_STATUS"
    if wait_for_process_stopped "$listener_pid"; then
      _pass "force residual listener: residual listener is gone"
    else
      _fail "force residual listener: residual listener is gone"
    fi
    kill -9 "$listener_pid" 2>/dev/null || true
    _assert_contains "force residual listener: forwards summary present" \
      'shell [ssh] local' "$COMMAND_OUTPUT"
  else
    if [[ $COMMAND_STATUS -ne 0 ]]; then
      _pass "force residual listener: fails without owner resolution"
    else
      _fail "force residual listener: fails without owner resolution"
    fi
    _assert_contains "force residual listener: diagnostic names the port" \
      '19233' "$COMMAND_OUTPUT"
    if kill -0 "$listener_pid" 2>/dev/null; then
      _pass "force residual listener: unresolvable listener is untouched"
    else
      _fail "force residual listener: unresolvable listener is untouched"
    fi
    kill -9 "$listener_pid" 2>/dev/null || true
  fi
}


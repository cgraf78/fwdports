force_dependency_preflight_preserves_active_case() {
  local driver tmp config output active_before active_after generation_nonce
  local generation_before observed expected_diagnostic

  for driver in ssh autossh et ettun; do
    tmp=$(_tmpdir) || return 1
    setup_case_root "$tmp"
    config=$CASE_CONFIG/fwdports/tunnels.conf
    output=$tmp/output
    printf '%s\n' \
      'profile default' \
      'leg shell' \
      'set shell host shell.example.com' \
      'set shell remote-forward 127.0.0.1:19090:127.0.0.1:9090' >"$config"
    chmod 0600 "$config"

    run_fwdports "$output" start
    _assert_exit "forced $driver preflight: stable generation starts" 0 \
      "$COMMAND_STATUS"
    active_before=$(<"$CASE_STATE/fwdports/active")
    generation_nonce=$(LC_ALL=C sed -n 's/^generation\t//p' \
      "$CASE_STATE/fwdports/active")
    generation_before=$CASE_STATE/fwdports/generations/$generation_nonce

    case "$driver" in
      ssh)
        CASE_SSH=$tmp/bin/missing-ssh
        expected_diagnostic='OpenSSH executable is not available'
        printf '%s\n' \
          'profile default' \
          'leg replacement ssh' \
          'set replacement host shell.example.com' \
          'set replacement remote-forward 127.0.0.1:19091:127.0.0.1:9091' \
          >"$config"
        ;;
      autossh)
        expected_diagnostic='autossh is not available'
        printf '%s\n' \
          'profile default' \
          'leg replacement autossh' \
          'set replacement host shell.example.com' \
          'set replacement remote-forward 127.0.0.1:19091:127.0.0.1:9091' \
          >"$config"
        ;;
      et)
        expected_diagnostic='Eternal Terminal executable is not available'
        printf '%s\n' \
          'profile default' \
          'leg replacement et' \
          'set replacement host gateway.example.net' \
          'set replacement remote-forward 127.0.0.1:19091:target.example.net:9091' \
          >"$config"
        ;;
      ettun)
        expected_diagnostic='ettun executable is not available'
        printf '%s\n' \
          'profile default' \
          'leg replacement ettun' \
          'set replacement host gateway.example.net' \
          'set replacement local-forward 127.0.0.1:18080:target.example.net:3389' \
          'check replacement loopback 18080 relay' >"$config"
        ;;
    esac
    chmod 0600 "$config"

    run_fwdports "$output" start --force
    if [[ $COMMAND_STATUS -ne 0 ]]; then
      _pass "forced $driver preflight: replacement fails"
    else
      _fail "forced $driver preflight: replacement fails"
    fi
    _assert_contains "forced $driver preflight: diagnostic names dependency" \
      "$expected_diagnostic" "$COMMAND_OUTPUT"
    active_after=
    [[ ! -f $CASE_STATE/fwdports/active ]] ||
      active_after=$(<"$CASE_STATE/fwdports/active")
    _assert_eq "forced $driver preflight: active pointer is unchanged" \
      "$active_before" "$active_after"
    _assert_file "forced $driver preflight: active manifest remains" \
      "$generation_before/manifest"
    _assert_not_exists "forced $driver preflight: no candidate is pending" \
      "$CASE_STATE/fwdports/pending"

    run_fwdports "$output" status
    observed=$COMMAND_OUTPUT
    _assert_exit "forced $driver preflight: old generation remains observable" \
      0 "$COMMAND_STATUS"
    _assert_eq "forced $driver preflight: old transport remains live" \
      live/unverified "$observed"

    run_fwdports "$output" stop
    _assert_exit "forced $driver preflight: cleanup succeeds" 0 \
      "$COMMAND_STATUS"
  done
}


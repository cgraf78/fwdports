#!/usr/bin/env bash
# End-to-end command lifecycle on an isolated real tmux socket.
# Named cases and TEST_CASE are consumed indirectly by the shared harness.
# shellcheck disable=SC2329,SC2016,SC2034

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
FWDPORTS=$ROOT/bin/fwdports
TEST_CASE=${1:-}
TMUX_BIN=${FWDPORTS_TEST_TMUX_BIN:-$(command -v tmux)}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"
# shellcheck source=../lib/fwdports/runtime.sh
source "$ROOT/lib/fwdports/runtime.sh"
# shellcheck source=../lib/fwdports/tmux.sh
source "$ROOT/lib/fwdports/tmux.sh"
# shellcheck source=../lib/fwdports/core.sh
source "$ROOT/lib/fwdports/core.sh"

run_fwdports() {
  local output=$1
  shift
  set +e
  HOME=$CASE_HOME XDG_CONFIG_HOME=$CASE_CONFIG XDG_STATE_HOME=$CASE_STATE \
    XDG_RUNTIME_DIR=$CASE_RUNTIME FWDPORTS_TMUX_SOCKET=$CASE_SOCKET \
    FWDPORTS_SSH_COMMAND=$CASE_SSH FWDPORTS_TEST_SSH_LOG=$CASE_SSH_LOG \
    FWDPORTS_AUTOSSH_COMMAND=$CASE_AUTOSSH \
    FWDPORTS_ET_COMMAND=$CASE_ET \
    FWDPORTS_ETTUN_COMMAND=$CASE_ETTUN \
    FWDPORTS_ETTUN_ET_COMMAND=$CASE_ET \
    FWDPORTS_TEST_ET_LOG=${FWDPORTS_TEST_ET_LOG:-} \
    FWDPORTS_TEST_PANE_TITLE=${FWDPORTS_TEST_PANE_TITLE:-} \
    FWDPORTS_TEST_SSH_ONESHOT=${FWDPORTS_TEST_SSH_ONESHOT:-} \
    FWDPORTS_TEST_SSH_RUNS=${FWDPORTS_TEST_SSH_RUNS:-} \
    FWDPORTS_CONTROLLER_TICK_SECONDS=${FWDPORTS_CONTROLLER_TICK_SECONDS:-1} \
    FWDPORTS_HEALTH_STARTUP_GRACE_TICKS=${FWDPORTS_HEALTH_STARTUP_GRACE_TICKS:-5} \
    FWDPORTS_HEALTH_INTERVAL_TICKS=${FWDPORTS_HEALTH_INTERVAL_TICKS:-30} \
    "$FWDPORTS" "$@" >"$output" 2>&1
  COMMAND_STATUS=$?
  COMMAND_OUTPUT=$(<"$output")
}

# A process fwdports just stopped can still answer kill -0 for a moment:
# the signal may be in flight, or the exit may be sitting as an unreaped
# zombie, which kill -0 reports as alive even though the product
# correctly treats it as stopped. Poll for the stopped condition
# instead of sampling it once; absent, zombie, and dead rows all count
# as stopped. Pid 0 is this file's unset-pid fallback, never a waited-on
# process, so it reports stopped.
wait_for_process_stopped() {
  local pid=$1 attempts=0 record state
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ $pid -eq 0 ]] && return 0
  while [[ $attempts -lt 200 ]]; do
    if ! record=$(_fwdports_process_snapshot "$pid" 2>/dev/null); then
      return 0
    fi
    state=${record##*$'\t'}
    [[ $state == Z* || $state == X* ]] && return 0
    sleep 0.01
    attempts=$((attempts + 1))
  done
  return 1
}

configured_health_case() {
  local tmp config output index=0 observed=''
  tmp=$(_tmpdir) || return 1
  setup_case_root "$tmp"
  config=$CASE_CONFIG/fwdports/tunnels.conf
  output=$tmp/output
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    '[[ " $* " != *" -w 1 "* ]]' >"$tmp/bin/nc"
  chmod 0700 "$tmp/bin/nc"
  printf '%s\n' \
    'profile default' \
    'leg shell' \
    'set shell host shell.example.com' \
    'set shell remote-forward 127.0.0.1:19090:127.0.0.1:9090' \
    'check shell tcp 127.0.0.1 19090 endpoint' >"$config"
  chmod 0600 "$config"
  PATH="$tmp/bin:$PATH" FWDPORTS_CONTROLLER_TICK_SECONDS=0.01 \
    FWDPORTS_HEALTH_STARTUP_GRACE_TICKS=1 \
    FWDPORTS_HEALTH_INTERVAL_TICKS=1 run_fwdports "$output" start
  _assert_exit "CLI health: checked profile starts" 0 "$COMMAND_STATUS"
  while [[ $index -lt 200 ]]; do
    PATH="$tmp/bin:$PATH" FWDPORTS_CONTROLLER_TICK_SECONDS=0.01 \
      FWDPORTS_HEALTH_STARTUP_GRACE_TICKS=1 \
      FWDPORTS_HEALTH_INTERVAL_TICKS=1 run_fwdports "$output" status
    observed=$COMMAND_OUTPUT
    [[ $observed == healthy ]] && break
    sleep 0.01
    index=$((index + 1))
  done
  _assert_eq "CLI health: service success becomes healthy" healthy "$observed"
  PATH="$tmp/bin:$PATH" run_fwdports "$output" stop
  if [[ $COMMAND_STATUS -eq 0 ]]; then
    _pass "CLI health: checked profile stops"
  else
    _fail "CLI health: checked profile stops (exit $COMMAND_STATUS: $COMMAND_OUTPUT)"
  fi
}

tmux_observability_case() {
  local tmp config output generation session windows labels heights pointer
  local digest attach_record expected_record attach_snapshot
  local border_status border_format selected_window first_height second_height
  tmp=$(_tmpdir) || return 1
  setup_case_root "$tmp"
  config=$CASE_CONFIG/fwdports/tunnels.conf
  output=$tmp/output
  printf '%s\n' \
    'profile default' \
    'leg z-first' \
    'set z-first host shell.example.com' \
    'set z-first remote-forward 127.0.0.1:19090:127.0.0.1:9090' \
    'leg a-second' \
    'set a-second host shell.example.com' \
    'set a-second remote-forward 127.0.0.1:19091:127.0.0.1:9091' >"$config"
  chmod 0600 "$config"

  FWDPORTS_TEST_PANE_TITLE=transport-output run_fwdports "$output" start
  _assert_exit "tmux observability: two-leg profile starts" \
    0 "$COMMAND_STATUS"
  generation=$(printf '%s\n' "$CASE_STATE/fwdports/generations"/*)
  session=$(LC_ALL=C sed -n $'s/^session-id\t//p' \
    "$generation/legs/z-first/pane")
  windows=$(TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$CASE_SOCKET" \
    -f /dev/null list-windows -t "$session" \
    -F $'#{window_name}\t#{window_panes}\t#{window_active}' 2>/dev/null) ||
    windows=unavailable
  labels=$(TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$CASE_SOCKET" \
    -f /dev/null list-panes -t "$session:forwards" \
    -F '#{@fwdports_label}' 2>/dev/null) || labels=unavailable
  heights=$(TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$CASE_SOCKET" \
    -f /dev/null list-panes -t "$session:forwards" \
    -F '#{pane_height}' 2>/dev/null) || heights=unavailable
  border_status=$(TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$CASE_SOCKET" \
    -f /dev/null show-options -wqv -t "$session:forwards" \
    pane-border-status 2>/dev/null) || border_status=unavailable
  border_format=$(TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$CASE_SOCKET" \
    -f /dev/null show-options -wqv -t "$session:forwards" \
    pane-border-format 2>/dev/null) || border_format=unavailable
  selected_window=$(TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$CASE_SOCKET" \
    -f /dev/null display-message -p -t "$session" \
    '#{window_name}' 2>/dev/null) || selected_window=unavailable

  _assert_contains "tmux observability: forwards have a dedicated window" \
    $'forwards\t2\t1' "$windows"
  _assert_contains "tmux observability: controller has a separate window" \
    $'control\t1\t0' "$windows"
  _assert_eq "tmux observability: every transport pane names leg and driver" \
    $'z-first [ssh]\na-second [ssh]' "$labels"
  _assert_eq "tmux observability: transport labels are visible" \
    top "$border_status"
  _assert_eq "tmux observability: pane border renders the stable label" \
    ' #{@fwdports_label} ' "$border_format"
  _assert_eq "tmux observability: attach defaults to transport output" \
    forwards "$selected_window"
  first_height=${heights%%$'\n'*}
  second_height=${heights#*$'\n'}
  if [[ $first_height =~ ^[0-9]+$ && $second_height =~ ^[0-9]+$ &&
    $((first_height - second_height)) -le 1 &&
    $((second_height - first_height)) -le 1 ]]; then
    _pass "tmux observability: transport panes share space evenly"
  else
    _fail "tmux observability: transport panes share space evenly (heights '$heights')"
  fi

  pointer=$(fwdports_pointer_read "$CASE_STATE/fwdports" active) || return 1
  IFS=$'\t' read -r _ digest <<<"$pointer"
  attach_snapshot=$tmp/attach-manifest
  attach_record=$(_fwdports_attach_pane_record "$generation" "$digest" \
    "$attach_snapshot") || return 1
  expected_record=$(_fwdports_pane_evidence_read "$generation" "$digest" \
    "$generation/legs/z-first/pane") || return 1
  _assert_eq "tmux attach: declaration order wins over lexical leg order" \
    "$expected_record" "$attach_record"

  run_fwdports "$output" stop
  _assert_exit "tmux observability: split-window profile stops cleanly" \
    0 "$COMMAND_STATUS"
}

inspect_observability_case() {
  local tmp config output generation_before generation_after observed=''
  local index=0 pane_pattern controller_pattern inspect_output
  tmp=$(_tmpdir) || return 1
  setup_case_root "$tmp"
  config=$CASE_CONFIG/fwdports/tunnels.conf
  output=$tmp/output
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    '[[ " $* " == *" -w 1 "* ]] && exit 1' \
    '[[ " $* " != *" 19090 "* ]]' \
    >"$tmp/bin/nc"
  chmod 0700 "$tmp/bin/nc"
  printf '%s\n' \
    'profile default' \
    'leg web' \
    'set web host shell.example.com' \
    'set web local-forward 127.0.0.1:18080:127.0.0.1:8080' \
    'check web loopback 18080 web-listener' \
    'leg api' \
    'set api host shell.example.com' \
    'set api remote-forward 127.0.0.1:19090:127.0.0.1:9090' \
    'check api tcp 127.0.0.1 19090 api-listener' >"$config"
  chmod 0600 "$config"

  PATH="$tmp/bin:$PATH" FWDPORTS_CONTROLLER_TICK_SECONDS=0.01 \
    FWDPORTS_HEALTH_STARTUP_GRACE_TICKS=1 \
    FWDPORTS_HEALTH_INTERVAL_TICKS=1 run_fwdports "$output" start
  _assert_exit "inspect active: checked two-leg profile starts" \
    0 "$COMMAND_STATUS"
  generation_before=$(basename "$CASE_STATE/fwdports/generations"/*)
  while [[ $index -lt 200 ]]; do
    PATH="$tmp/bin:$PATH" FWDPORTS_CONTROLLER_TICK_SECONDS=0.01 \
      FWDPORTS_HEALTH_STARTUP_GRACE_TICKS=1 \
      FWDPORTS_HEALTH_INTERVAL_TICKS=1 run_fwdports "$output" status
    observed=$COMMAND_OUTPUT
    [[ $observed == degraded ]] && break
    sleep 0.01
    index=$((index + 1))
  done
  _assert_eq "inspect active: aggregate status identifies a failed check" \
    degraded "$observed"

  PATH="$tmp/bin:$PATH" run_fwdports "$output" inspect
  inspect_output=$COMMAND_OUTPUT
  _assert_exit "inspect active: human report succeeds" 0 "$COMMAND_STATUS"
  _assert_contains "inspect active: names the report" \
    'fwdports inspect' "$inspect_output"
  _assert_contains "inspect active: reports overall state" \
    '  overall: degraded' "$inspect_output"
  _assert_contains "inspect active: reports selected profile" \
    '  profile: default' "$inspect_output"
  _assert_contains "inspect active: reports authenticated generation" \
    '  generation: generation.' "$inspect_output"
  _assert_contains "inspect active: states check limitations" \
    'local TCP connect only; not end-to-end destination proof' \
    "$inspect_output"
  _assert_contains "inspect active: names first leg and driver" \
    '    web [ssh]' "$inspect_output"
  _assert_contains "inspect active: names second leg and driver" \
    '    api [ssh]' "$inspect_output"
  _assert_contains "inspect active: reports declared local forward" \
    'standard forward: local 127.0.0.1:18080:127.0.0.1:8080' \
    "$inspect_output"
  _assert_contains "inspect active: reports declared remote forward" \
    'standard forward: remote 127.0.0.1:19090:127.0.0.1:9090' \
    "$inspect_output"
  _assert_contains "inspect active: reports the passing check result" \
    'check: passing; point-in-time local TCP connect to 127.0.0.1 port 18080 (loopback; label web-listener)' \
    "$inspect_output"
  _assert_contains "inspect active: identifies the failing leg check" \
    'check: failing; point-in-time local TCP connect to 127.0.0.1 port 19090 (tcp; label api-listener)' \
    "$inspect_output"
  pane_pattern='tmux: live; session \$[0-9]+; window @[0-9]+ \(forwards\); pane %[0-9]+; pid [0-9]+'
  if [[ $inspect_output =~ $pane_pattern ]]; then
    _pass "inspect active: reports transport pane and window identity"
  else
    _fail "inspect active: reports transport pane and window identity"
  fi
  controller_pattern='controller: live; session \$[0-9]+; window @[0-9]+ \(control\); pane %[0-9]+; pid [0-9]+'
  if [[ $inspect_output =~ $controller_pattern ]]; then
    _pass "inspect active: reports controller pane and window identity"
  else
    _fail "inspect active: reports controller pane and window identity"
  fi
  _assert_contains "inspect active: distinguishes supervisor from transport" \
    'transport: not separately observed (supervisor live)' "$inspect_output"

  PATH="$tmp/bin:$PATH" run_fwdports "$output" status
  _assert_exit "inspect active: machine status still succeeds" \
    0 "$COMMAND_STATUS"
  _assert_eq "inspect active: machine status remains one token" \
    degraded "$COMMAND_OUTPUT"
  generation_after=$(basename "$CASE_STATE/fwdports/generations"/*)
  _assert_eq "inspect active: report does not churn generation" \
    "$generation_before" "$generation_after"

  PATH="$tmp/bin:$PATH" run_fwdports "$output" stop
  _assert_exit "inspect active: inspected profile stops cleanly" \
    0 "$COMMAND_STATUS"
}

inspect_builtin_backoff_case() {
  local tmp config output runs inspect_output index=0 run_count=0
  tmp=$(_tmpdir) || return 1
  setup_case_root "$tmp"
  config=$CASE_CONFIG/fwdports/tunnels.conf
  output=$tmp/output
  runs=$tmp/ssh-runs
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'if [[ ${1:-} == -V ]]; then printf "OpenSSH_9.9p1 test\n" >&2; exit 0; fi' \
    'if [[ ${1:-} == -G ]]; then' \
    '  printf "hostname shell.example.com\nuser example\nport 22\nforwardagent no\n"' \
    '  exit 0' \
    'fi' \
    'printf "run\n" >>"$FWDPORTS_TEST_SSH_RUNS"' \
    'exit 0' >"$CASE_SSH"
  chmod 0700 "$CASE_SSH"
  printf '%s\n' \
    'profile default' \
    'leg retrying' \
    'set retrying host shell.example.com' \
    'set retrying remote-forward 127.0.0.1:19090:127.0.0.1:9090' \
    >"$config"
  chmod 0600 "$config"

  FWDPORTS_TEST_SSH_RUNS=$runs run_fwdports "$output" start
  _assert_exit "inspect SSH backoff: profile starts" 0 "$COMMAND_STATUS"
  while [[ $index -lt 500 ]]; do
    if [[ -f $runs ]]; then
      run_count=$(wc -l <"$runs" | tr -d '[:space:]')
      [[ $run_count -ge 3 ]] && break
    fi
    sleep 0.01
    index=$((index + 1))
  done
  _assert_eq "inspect SSH backoff: transport has entered repeated retry" \
    3 "$run_count"
  sleep 0.05

  FWDPORTS_TEST_SSH_RUNS=$runs run_fwdports "$output" inspect
  inspect_output=$COMMAND_OUTPUT
  _assert_exit "inspect SSH backoff: live supervisor remains inspectable" \
    0 "$COMMAND_STATUS"
  _assert_contains "inspect SSH backoff: does not equate supervisor with transport" \
    'transport: not separately observed (supervisor live)' "$inspect_output"
  _assert_not_contains "inspect SSH backoff: makes no live transport claim" \
    'transport: live' "$inspect_output"

  FWDPORTS_TEST_SSH_RUNS=$runs run_fwdports "$output" stop
  _assert_exit "inspect SSH backoff: profile stops cleanly" 0 "$COMMAND_STATUS"
}

write_external_driver() {
  local path=$1
  mkdir -p "${path%/*}"
  chmod 0700 "${path%/*}"
  cat >"$path" <<'DRIVER'
#!/usr/bin/env bash
set -u
case "${1:-}" in
  api-version) printf '1\n' ;;
  validate) printf 'validated\n' >>"$4/events" ;;
  prepare) printf 'prepared\n' >>"$4/events" ;;
  run)
    leg=$3
    printf '%s\n' "$$" >"$FWDPORTS_TEST_EXTERNAL_STATE/$leg.pid"
    # Record that the driver's TERM trap ran instead of inferring that state
    # from kill -0. On Linux, an exited pane can remain as an unreaped zombie
    # for a moment; kill -0 still succeeds for that zombie even though fwdports
    # correctly treats it as stopped.
    on_term() {
      : >"$FWDPORTS_TEST_EXTERNAL_STATE/$leg.terminated"
      printf 'term-%s\n' "$leg" >>"$FWDPORTS_TEST_EXTERNAL_ORDER"
      exit 0
    }
    trap on_term HUP INT TERM
    # Publish the simulated listener only after signals are safe to handle.
    # The test treats this file as readiness evidence before requesting stop.
    : >"$FWDPORTS_TEST_EXTERNAL_STATE/$leg.listener"
    while :; do sleep 1; done
    ;;
  is-live) exit 2 ;;
  cleanup)
    leg=$3
    phase=before-term
    if [[ -e $FWDPORTS_TEST_EXTERNAL_STATE/$leg.terminated ]]; then
      phase=after-term
    else
      # The first cleanup pass must get an opportunity to retire driver-owned
      # resources before the core sends TERM to the pane.
      rm -f -- "$FWDPORTS_TEST_EXTERNAL_STATE/$leg.listener"
    fi
    printf 'cleanup-%s-%s\n' "$phase" "$leg" \
      >>"$FWDPORTS_TEST_EXTERNAL_ORDER"
    ;;
  *) exit 64 ;;
esac
DRIVER
  chmod 0700 "$path"
}

shared_external_driver_case() {
  local tmp config output generation driver_count first_events second_events
  local lifecycle_state lifecycle_order cleanup_order first_pid second_pid
  local tick=0
  tmp=$(_tmpdir) || return 1
  setup_case_root "$tmp"
  config=$CASE_CONFIG/fwdports/tunnels.conf
  output=$tmp/output
  lifecycle_state=$tmp/external-state
  lifecycle_order=$tmp/external-order
  mkdir -m 0700 "$lifecycle_state"
  write_external_driver "$CASE_CONFIG/fwdports/drivers.d/example"
  printf '%s\n' \
    'profile default' \
    'leg first example' \
    'set first local-forward 127.0.0.1:18080:127.0.0.1:8080' \
    'leg second example' \
    'set second remote-forward 127.0.0.1:19090:127.0.0.1:9090' >"$config"
  chmod 0600 "$config"

  FWDPORTS_TEST_EXTERNAL_STATE=$lifecycle_state \
    FWDPORTS_TEST_EXTERNAL_ORDER=$lifecycle_order \
    run_fwdports "$output" start
  _assert_exit "external driver reuse: two legs start" 0 "$COMMAND_STATUS"
  _assert_eq "start summary: preserves manifest order and driver names" \
    $'fwdports: started profile default\nfwdports: forwards\n  first [example] local 127.0.0.1:18080:127.0.0.1:8080\n  second [example] remote 127.0.0.1:19090:127.0.0.1:9090' \
    "$COMMAND_OUTPUT"
  generation=$(printf '%s\n' "$CASE_STATE/fwdports/generations"/*)
  driver_count=$(printf '%s\n' "$generation/drivers"/example | wc -l |
    tr -d '[:space:]')
  _assert_eq "external driver reuse: snapshots one executable" \
    1 "$driver_count"
  first_events=$(<"$generation/legs/first/events")
  second_events=$(<"$generation/legs/second/events")
  _assert_eq "external driver reuse: prepares first leg" \
    $'validated\nprepared' "$first_events"
  _assert_eq "external driver reuse: prepares second leg" \
    $'validated\nprepared' "$second_events"

  while [[ $tick -lt 200 ]]; do
    if [[ -s $lifecycle_state/first.pid &&
      -s $lifecycle_state/second.pid &&
      -e $lifecycle_state/first.listener &&
      -e $lifecycle_state/second.listener ]]; then
      first_pid=$(<"$lifecycle_state/first.pid")
      second_pid=$(<"$lifecycle_state/second.pid")
      if kill -0 "$first_pid" 2>/dev/null &&
        kill -0 "$second_pid" 2>/dev/null; then
        break
      fi
    fi
    sleep 0.01
    tick=$((tick + 1))
  done
  if [[ $tick -lt 200 ]]; then
    _pass "external driver cleanup: both run processes and listeners are live"
  else
    _fail "external driver cleanup: both run processes and listeners are live"
    first_pid=${first_pid:-0}
    second_pid=${second_pid:-0}
  fi

  run_fwdports "$output" status
  _assert_exit "external driver reuse: status succeeds" 0 "$COMMAND_STATUS"
  _assert_eq "external driver reuse: both panes remain live" \
    live/unverified "$COMMAND_OUTPUT"
  run_fwdports "$output" inspect
  _assert_exit "external driver inspect: human report succeeds" \
    0 "$COMMAND_STATUS"
  _assert_contains "external driver inspect: identifies driver per leg" \
    '    first [example]' "$COMMAND_OUTPUT"
  _assert_contains "external driver inspect: distinguishes pane liveness" \
    'transport: not separately reported (pane live)' "$COMMAND_OUTPUT"
  FWDPORTS_TEST_EXTERNAL_STATE=$lifecycle_state \
    FWDPORTS_TEST_EXTERNAL_ORDER=$lifecycle_order \
    run_fwdports "$output" stop
  _assert_exit "external driver reuse: authenticated stop succeeds" \
    0 "$COMMAND_STATUS"
  cleanup_order=$(awk '/^(cleanup|term)-/ { print }' "$lifecycle_order")
  _assert_eq "external driver cleanup: pre-TERM hooks precede TERM and final hooks" \
    $'cleanup-before-term-second\ncleanup-before-term-first\nterm-first\nterm-second\ncleanup-after-term-second\ncleanup-after-term-first' \
    "$cleanup_order"
  _assert_not_exists "external driver cleanup: first listener is retired" \
    "$lifecycle_state/first.listener"
  _assert_not_exists "external driver cleanup: second listener is retired" \
    "$lifecycle_state/second.listener"
  if wait_for_process_stopped "$first_pid" &&
    wait_for_process_stopped "$second_pid"; then
    _pass "external driver cleanup: all run processes exit"
  else
    _fail "external driver cleanup: all run processes exit"
  fi
}

setup_case_root() {
  local tmp=$1
  CASE_HOME=$tmp/home
  CASE_CONFIG=$tmp/config
  CASE_STATE=$tmp/state
  CASE_RUNTIME=$tmp/runtime
  CASE_SOCKET=$CASE_RUNTIME/fwdports.sock
  CASE_SSH=$tmp/bin/ssh
  CASE_AUTOSSH=$tmp/bin/autossh
  CASE_ET=$tmp/bin/et
  CASE_ETTUN=$tmp/bin/ettun
  CASE_SSH_LOG=$tmp/ssh.log
  mkdir -p "$CASE_HOME" "$CASE_CONFIG/fwdports" "$CASE_STATE" \
    "$CASE_RUNTIME" "$tmp/bin"
  chmod 0700 "$CASE_HOME" "$CASE_CONFIG" "$CASE_CONFIG/fwdports" \
    "$CASE_STATE" "$CASE_RUNTIME" "$tmp/bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'if [[ ${1:-} == -V ]]; then printf "OpenSSH_9.9p1 test\n" >&2; exit 0; fi' \
    'if [[ ${1:-} == -G ]]; then' \
    '  printf "hostname shell.example.com\nuser example\nport 22\nforwardagent no\n"' \
    '  exit 0' \
    'fi' \
    'printf "%s\n" "$@" >"$FWDPORTS_TEST_SSH_LOG"' \
    '[[ -z ${FWDPORTS_TEST_SSH_ONESHOT:-} ]] || { printf "IDPASSKEY:XXXXXXXXXXXXXXXX/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n"; exit 0; }' \
    '[[ -z ${FWDPORTS_TEST_PANE_TITLE:-} ]] || printf "\033]2;%s\007" "$FWDPORTS_TEST_PANE_TITLE"' \
    'trap "exit 0" INT TERM HUP' \
    'while :; do sleep 1; done' >"$CASE_SSH"
  chmod 0700 "$CASE_SSH"
}

later_builtin_dependency_failure_case() {
  local tmp config output
  tmp=$(_tmpdir) || return 1
  setup_case_root "$tmp"
  config=$CASE_CONFIG/fwdports/tunnels.conf
  output=$tmp/output

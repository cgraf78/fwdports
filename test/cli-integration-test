process_stopped_helper_case() {
  local tmp holder zombie_pid index=0
  tmp=$(_tmpdir) || return 1
  # Hold a real zombie: the child exits at once while the parent sleeps
  # without reaping, so kill -0 still succeeds for a process the product
  # treats as stopped.
  python3 -c 'import os, sys, time
pid = os.fork()
if pid == 0:
    os._exit(0)
sys.stdout.write(f"{pid}\n")
sys.stdout.flush()
time.sleep(30)' >"$tmp/zombie.pid" 2>/dev/null &
  holder=$!
  while [[ ! -s "$tmp/zombie.pid" && $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  if [[ -s "$tmp/zombie.pid" ]]; then
    zombie_pid=$(<"$tmp/zombie.pid")
  else
    zombie_pid=""
  fi
  if [[ -n $zombie_pid ]] && kill -0 "$zombie_pid" 2>/dev/null; then
    _pass "process stopped helper: fixture holds a kill -0-visible zombie"
  else
    _fail "process stopped helper: fixture holds a kill -0-visible zombie"
  fi
  if [[ -n $zombie_pid ]] && wait_for_process_stopped "$zombie_pid"; then
    _pass "process stopped helper: zombie counts as stopped"
  else
    _fail "process stopped helper: zombie counts as stopped"
  fi
  if wait_for_process_stopped "999999999"; then
    _pass "process stopped helper: absent pid counts as stopped"
  else
    _fail "process stopped helper: absent pid counts as stopped"
  fi
  kill -9 "$holder" 2>/dev/null || true
  wait "$holder" 2>/dev/null || true
}


#!/usr/bin/env bash
# Case callbacks are passed by name to the shared harness.
# shellcheck disable=SC2329

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
TEST_CASE=${1:-}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"
# shellcheck source=../lib/fwdports/config.sh
source "$ROOT/lib/fwdports/config.sh"

resolve_config() {
  local config=$1 profile=$2 output=$3 error=$4
  set +e
  fwdports_config_resolve "$config" "$profile" "$output" 2>"$error"
  RESOLVE_STATUS=$?
  RESOLVE_ERROR=$(<"$error")
  RESOLVE_OUTPUT=
  if [[ -f "$output" ]]; then
    RESOLVE_OUTPUT=$(<"$output")
  fi
}

minimal_profile_case() {
  local tmp config output error expected
  tmp=$(_tmpdir) || return 1
  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf '%s\n' \
    'profile demo' \
    'leg web' \
    'set web host shell.example.com' \
    'set web local-forward 127.0.0.1:8080:127.0.0.1:8080' >"$config"
  expected=$(printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:8080')

  resolve_config "$config" demo "$output" "$error"
  _assert_exit "config minimal: resolves" 0 "$RESOLVE_STATUS"
  _assert_eq "config minimal: canonical records" "$expected" "$RESOLVE_OUTPUT"
  _assert_eq "config minimal: no diagnostics" "" "$RESOLVE_ERROR"
}

default_ssh_case() {
  local tmp implicit explicit implicit_out explicit_out error
  tmp=$(_tmpdir) || return 1
  implicit="$tmp/implicit.conf"
  explicit="$tmp/explicit.conf"
  implicit_out="$tmp/implicit.out"
  explicit_out="$tmp/explicit.out"
  error="$tmp/error"
  printf '%s\n' 'profile demo' 'leg web' >"$implicit"
  printf '%s\n' 'profile demo' 'leg web ssh' >"$explicit"

  resolve_config "$implicit" demo "$implicit_out" "$error"
  _assert_exit "config default driver: implicit resolves" 0 "$RESOLVE_STATUS"
  resolve_config "$explicit" demo "$explicit_out" "$error"
  _assert_exit "config default driver: explicit resolves" 0 "$RESOLVE_STATUS"
  _assert_eq "config default driver: implicit and explicit normalize equally" \
    "$(<"$implicit_out")" "$(<"$explicit_out")"
}

unsafe_name_case() {
  local tmp config output error
  tmp=$(_tmpdir) || return 1
  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf '%s\n' 'profile demo;touch' 'leg web' >"$config"

  resolve_config "$config" demo "$output" "$error"
  _assert_exit "config validation: unsafe name is rejected" 1 \
    "$RESOLVE_STATUS"
  _assert_contains "config validation: unsafe name identifies record" \
    "invalid profile record" "$RESOLVE_ERROR"
  _assert_not_exists "config validation: unsafe name publishes nothing" \
    "$output"
}


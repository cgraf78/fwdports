extends_parent_case() {
  local tmp config output error expected
  tmp=$(_tmpdir) || return 1
  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf '%s\n' \
    'profile base' \
    'leg web' \
    'set web host shell.example.com' \
    'set web local-forward 127.0.0.1:8080:127.0.0.1:8080' \
    'profile child extends base' \
    'set web server-alive-interval 15' >"$config"
  expected=$(printf '%s\n' \
    $'version\t1' \
    $'profile\tchild' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:8080' \
    $'set\tweb\tserver-alive-interval\t15')

  resolve_config "$config" child "$output" "$error"
  _assert_exit "config inheritance: child resolves" 0 "$RESOLVE_STATUS"
  _assert_eq "config inheritance: parent records precede child" \
    "$expected" "$RESOLVE_OUTPUT"
}

reset_leg_case() {
  local tmp config output error expected
  tmp=$(_tmpdir) || return 1
  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf '%s\n' \
    'profile base' \
    'leg web' \
    'set web host old.example.com' \
    'set web local-forward 127.0.0.1:8080:127.0.0.1:8080' \
    'profile child extends base' \
    'reset web' \
    'set web host new.example.com' \
    'set web remote-forward 127.0.0.1:9090:127.0.0.1:9090' >"$config"
  expected=$(printf '%s\n' \
    $'version\t1' \
    $'profile\tchild' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tnew.example.com' \
    $'set\tweb\tremote-forward\t127.0.0.1:9090:127.0.0.1:9090')

  resolve_config "$config" child "$output" "$error"
  _assert_exit "config reset: inherited leg resolves" 0 "$RESOLVE_STATUS"
  _assert_eq "config reset: options clear but driver identity remains" \
    "$expected" "$RESOLVE_OUTPUT"
}

inheritance_cycle_case() {
  local tmp config output error
  tmp=$(_tmpdir) || return 1
  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf '%s\n' 'profile one extends two' 'profile two extends one' >"$config"

  resolve_config "$config" one "$output" "$error"
  _assert_exit "config inheritance: cycle is rejected" 1 "$RESOLVE_STATUS"
  _assert_contains "config inheritance: cycle is actionable" \
    "inheritance cycle" "$RESOLVE_ERROR"
  _assert_not_exists "config inheritance: cycle publishes nothing" "$output"
}

inheritance_depth_case() {
  local tmp config output error index
  tmp=$(_tmpdir) || return 1
  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf 'profile p0\n' >"$config"
  index=1
  while [[ $index -le 21 ]]; do
    printf 'profile p%s extends p%s\n' "$index" "$((index - 1))" >>"$config"
    index=$((index + 1))
  done

  resolve_config "$config" p21 "$output" "$error"
  _assert_exit "config inheritance: excessive depth is rejected" 1 \
    "$RESOLVE_STATUS"
  _assert_contains "config inheritance: depth bound is actionable" \
    "exceeds depth 20" "$RESOLVE_ERROR"
  _assert_not_exists "config inheritance: excessive depth publishes nothing" \
    "$output"
}

checks_and_failure_case() {
  local tmp config output error expected
  tmp=$(_tmpdir) || return 1
  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf '%s\n' \
    'profile demo' \
    'leg web' \
    'set web host shell.example.com' \
    'set web local-forward 127.0.0.1:8080:127.0.0.1:8080' \
    'check web loopback 8080' \
    'check web tcp 192.0.2.10 443 upstream' \
    'failure web preserve' >"$config"
  expected=$(printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:8080' \
    $'check\tweb\tloopback\t127.0.0.1\t8080\tweb' \
    $'check\tweb\ttcp\t192.0.2.10\t443\tupstream' \
    $'failure\tweb\tpreserve')

  resolve_config "$config" demo "$output" "$error"
  _assert_exit "config checks: records resolve" 0 "$RESOLVE_STATUS"
  _assert_eq "config checks: records normalize deterministically" \
    "$expected" "$RESOLVE_OUTPUT"
}

run_case minimal-profile minimal_profile_case
run_case default-ssh default_ssh_case
run_case unsafe-name unsafe_name_case
run_case unsafe-value unsafe_value_case
run_case duplicate-record duplicate_record_case
run_case unknown-directive unknown_directive_case
run_case extends-parent extends_parent_case
run_case reset-leg reset_leg_case
run_case inheritance-cycle inheritance_cycle_case
run_case inheritance-depth inheritance_depth_case
run_case checks-and-failure checks_and_failure_case
_test_summary

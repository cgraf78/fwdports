  config="$tmp/tunnels.conf"
  output="$tmp/resolved"
  error="$tmp/error"
  printf '%s\n' 'profile demo' 'leg web' 'launch web anything' >"$config"

  resolve_config "$config" demo "$output" "$error"
  _assert_exit "config validation: unknown directive is rejected" 1 \
    "$RESOLVE_STATUS"
  _assert_contains "config validation: unknown directive is actionable" \

#!/usr/bin/env bash
# Case callbacks and TEST_CASE are consumed indirectly by the shared harness.
# shellcheck disable=SC2329,SC2034
# Single-quoted fixture lines are expanded only by the child process.
# shellcheck disable=SC2016

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
TEST_CASE=${1:-}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"
# shellcheck source=../lib/fwdports/runtime.sh
source "$ROOT/lib/fwdports/runtime.sh"
# shellcheck source=../lib/fwdports/tmux.sh
source "$ROOT/lib/fwdports/tmux.sh"
# shellcheck source=../lib/fwdports/driver-api.sh
source "$ROOT/lib/fwdports/driver-api.sh"
# shellcheck source=../lib/fwdports/controller.sh
source "$ROOT/lib/fwdports/controller.sh"

TMUX_BIN=${FWDPORTS_TEST_TMUX_BIN:-$(command -v tmux)}

controller_fixture() {
  local tmp=$1 driver=${2:-ssh} home state source root generation digest
  home=$tmp/home
  state=$tmp/state
  source=$tmp/resolved-profile
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"
  printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\t'"$driver" \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:80' \
    >"$source"
  chmod 0600 "$source"
  root=$(HOME=$home XDG_STATE_HOME=$state fwdports_runtime_init) || return 1
  generation=$(fwdports_generation_create "$root" "$source") || return 1
  digest=$(fwdports_generation_manifest_digest "$generation") || return 1
  fwdports_control_write "$generation" "$digest" preparing running \
    none none unknown || return 1
  fwdports_pointer_publish "$root" pending "$generation" "$digest" ||
    return 1
  printf '%s\t%s\t%s\n' "$root" "$generation" "$digest"
}

write_status_driver() {
  local path=$1 result=$2
  mkdir -p "${path%/*}"
  chmod 0700 "${path%/*}"
  {
    printf '%s\n' '#!/usr/bin/env bash' 'set -u'
    printf 'case "${1:-}" in\n'
    printf '  is-live) printf "%%s\\n" "$2|$3|$4|$5" >"$4/is-live-call"; exit %s ;;\n' \
      "$result"
    printf '  *) exit 64 ;;\n'
    printf 'esac\n'
  } >"$path"
  chmod 0700 "$path"
}

wait_for_ready() {
  local path=$1 attempts=0
  while [[ ! -s "$path" && $attempts -lt 200 ]]; do
    sleep 0.01
    attempts=$((attempts + 1))
  done
  [[ -s "$path" ]]
}

start_test_controller() {
  local root=$1 generation=$2 digest=$3 stdout=$4 stderr=$5
  FWDPORTS_CONTROLLER_TICK_SECONDS=0.01 \
    FWDPORTS_CONTROLLER_MAX_TICKS=500 \
    bash "$ROOT/lib/fwdports/controller.sh" wait-for-activation \
    "$root" "$generation" "$digest" >"$stdout" 2>"$stderr" &
  CONTROLLER_PID=$!
}

wait_for_file() {
  local path=$1 attempts=0
  while [[ ! -s "$path" && $attempts -lt 200 ]]; do
    sleep 0.01
    attempts=$((attempts + 1))
  done
  [[ -s "$path" ]]
}

kill_test_server() {
  local socket=$1
  TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$socket" -f /dev/null \
    kill-server 2>/dev/null || true
}

start_status_pane() {
  local tmp=$1 generation=$2 digest=$3 fixture pid_file release record
  fixture=$tmp/status-leader
  pid_file=$tmp/status-pid
  release=$tmp/status-release
  STATUS_SOCKET=$tmp/status-tmux.sock
  STATUS_RELEASE=$release
  mkdir -p "$generation/legs/web"
  chmod 0700 "$generation/legs" "$generation/legs/web"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\\n" "$$" >"$1"' \
    'while [[ ! -e "$2" ]]; do sleep 0.01; done' \
    >"$fixture"
  chmod 0700 "$fixture"
  record=$(fwdports_tmux_create_session "$TMUX_BIN" "$STATUS_SOCKET" \
    fwdports "${generation##*/}" "$tmp" "$fixture" "$pid_file" "$release") ||
    return 1
  IFS=$'\t' read -r STATUS_SESSION STATUS_PANE <<<"$record"
  wait_for_file "$pid_file" || return 1
  fwdports_tmux_record_pane "$TMUX_BIN" "$STATUS_SOCKET" \
    "$STATUS_SESSION" "$STATUS_PANE" "$generation" "$digest" \
    "$generation/legs/web/pane"
}

activate_status_generation() {
  local tmp=$1 root=$2 generation=$3 digest=$4 start
  start_status_pane "$tmp" "$generation" "$digest" || return 1
  start=$(_fwdports_process_start_identity "$$")
  fwdports_control_write "$generation" "$digest" running running \
    "$$" "$start" none || return 1
  fwdports_pointer_publish "$root" active "$generation" "$digest"
}

run_recovery() {
  local root=$1 socket=$2 output=$3 error=$4
  set +e
  fwdports_recover_state "$TMUX_BIN" "$socket" "$root" fwdports \
    20 0.01 >"$output" 2>"$error"
  RECOVERY_STATUS=$?
}

controller_ready_case() {
  local tmp fixture root generation digest stdout stderr ready content
  tmp=$(_tmpdir) || return 1
  fixture=$(controller_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  stdout=$tmp/stdout
  stderr=$tmp/stderr
  ready=$generation/controller.ready

  start_test_controller "$root" "$generation" "$digest" "$stdout" "$stderr"
  wait_for_ready "$ready" || true
  content=
  [[ -f "$ready" ]] && content=$(<"$ready")

  _assert_file "controller ready: publishes a regular marker" "$ready"
  _assert_contains "controller ready: binds generation" \
    $'generation\t'"${generation##*/}" "$content"
  _assert_contains "controller ready: binds manifest digest" \
    $'manifest-digest\t'"$digest" "$content"
  _assert_contains "controller ready: records exact process" \
    $'controller-pid\t'"$CONTROLLER_PID" "$content"
  _assert_contains "controller ready: records process start identity" \
    $'controller-start\t' "$content"

  kill "$CONTROLLER_PID" 2>/dev/null || true
  wait "$CONTROLLER_PID" 2>/dev/null || true
}

controller_before_publish_case() {
  local tmp fixture root generation digest stdout stderr ready
  local pointer_before control_before alive=0
  tmp=$(_tmpdir) || return 1
  fixture=$(controller_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  stdout=$tmp/stdout
  stderr=$tmp/stderr
  ready=$generation/controller.ready
  pointer_before=$(<"$root/pending")
  control_before=$(<"$generation/control")

  start_test_controller "$root" "$generation" "$digest" "$stdout" "$stderr"
  wait_for_ready "$ready" || true
  sleep 0.05
  kill -0 "$CONTROLLER_PID" 2>/dev/null && alive=1

  _assert_eq "controller boot gate: waits before active publication" 1 "$alive"
  _assert_not_exists "controller boot gate: does not publish active" \
    "$root/active"
  _assert_eq "controller boot gate: does not change pending" \
    "$pointer_before" "$(<"$root/pending")"
  _assert_eq "controller boot gate: does not change control" \
    "$control_before" "$(<"$generation/control")"

  kill "$CONTROLLER_PID" 2>/dev/null || true
  wait "$CONTROLLER_PID" 2>/dev/null || true
}

controller_after_publish_case() {
  local tmp fixture root generation digest stdout stderr ready start status
  tmp=$(_tmpdir) || return 1
  fixture=$(controller_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  stdout=$tmp/stdout
  stderr=$tmp/stderr
  ready=$generation/controller.ready

  start_test_controller "$root" "$generation" "$digest" "$stdout" "$stderr"
  wait_for_ready "$ready" || true
  start=$(_fwdports_process_start_identity "$CONTROLLER_PID")
  fwdports_control_write "$generation" "$digest" running running \
    "$CONTROLLER_PID" "$start" unknown
  fwdports_pointer_publish "$root" active "$generation" "$digest"
  wait "$CONTROLLER_PID"
  status=$?

  _assert_exit "controller boot gate: releases after active publication" \
    0 "$status"
  _assert_eq "controller boot gate: emits activation result" \
    "activated" "$(<"$stdout")"
  _assert_eq "controller boot gate: activation has no diagnostic" \
    "" "$(<"$stderr")"
}

status_starting_case() {
  local tmp fixture root generation digest output error status
  tmp=$(_tmpdir) || return 1
  fixture=$(controller_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  output=$tmp/output
  error=$tmp/error

  set +e
  fwdports_status "$root" "$TMUX_BIN" "$tmp/unused.sock" fwdports \
    >"$output" 2>"$error"
  status=$?

  _assert_exit "status starting: succeeds" 0 "$status"
  _assert_eq "status starting: names pending state" "starting" "$(<"$output")"
  _assert_eq "status starting: needs no tmux server" "" "$(<"$error")"
}

status_live_unverified_case() {
  local tmp fixture root generation digest output error status start
  tmp=$(_tmpdir) || return 1
  fixture=$(controller_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  start_status_pane "$tmp" "$generation" "$digest" || return 1
  start=$(_fwdports_process_start_identity "$$")
  fwdports_control_write "$generation" "$digest" running running \
    "$$" "$start" none
  fwdports_pointer_publish "$root" active "$generation" "$digest"
  output=$tmp/output
  error=$tmp/error

  set +e
  fwdports_status "$root" "$TMUX_BIN" "$STATUS_SOCKET" fwdports \
    >"$output" 2>"$error"
  status=$?

  _assert_exit "status live unverified: succeeds" 0 "$status"
  _assert_eq "status live unverified: does not overclaim health" \
    "live/unverified" "$(<"$output")"
  _assert_eq "status live unverified: has no diagnostic" "" "$(<"$error")"
  : >"$STATUS_RELEASE"
  kill_test_server "$STATUS_SOCKET"
}

status_down_case() {
  local tmp fixture root generation digest output error status start
  tmp=$(_tmpdir) || return 1
  fixture=$(controller_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  start_status_pane "$tmp" "$generation" "$digest" || return 1
  start=$(_fwdports_process_start_identity "$$")
  fwdports_control_write "$generation" "$digest" running running \

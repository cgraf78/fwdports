remote_port_slot_case() {
  local tmp manifest first_runtime second_runtime repeated_runtime
  local first second repeated error status slot port direction
  tmp=$(_tmpdir) || return 1
  manifest=$tmp/manifest
  first_runtime=$tmp/first
  second_runtime=$tmp/second
  repeated_runtime=$tmp/repeated
  error=$tmp/error
  mkdir -p "$first_runtime" "$second_runtime" "$repeated_runtime"
  chmod 0700 "$first_runtime" "$second_runtime" "$repeated_runtime"
  printf '%s\n' \
    $'version\t1' \
    $'generation\tgeneration.slot-test' \
    $'target\tnone' \
    $'profile\tdemo' \
    $'leg\tfixed-local\tssh' \
    $'set\tfixed-local\tlocal-forward\t49152:127.0.0.1:22' \
    $'leg\tfixed-remote\tssh' \
    $'set\tfixed-remote\tremote-forward\t127.0.0.1:49153:127.0.0.1:22' \
    $'leg\tfirst\tettun' \
    $'set\tfirst\thost\tgateway.example.net' \
    $'set\tfirst\tlocal-forward\t127.0.0.1:18080:desktop.example.net:3389' \
    $'leg\tsecond\tettun' \
    $'set\tsecond\thost\tgateway.example.net' \
    $'set\tsecond\tlocal-forward\t127.0.0.1:18081:desktop.example.net:3389' \
    >"$manifest"
  chmod 0600 "$manifest"

  _fwdports_ettun_assign_remote_port_slot "$manifest" second \
    "$second_runtime/ettun-remote-port-slot-v1" || return 1
  _fwdports_ettun_assign_remote_port_slot "$manifest" first \
    "$first_runtime/ettun-remote-port-slot-v1" || return 1
  _fwdports_ettun_assign_remote_port_slot "$manifest" first \
    "$repeated_runtime/ettun-remote-port-slot-v1" || return 1
  first=$(<"$first_runtime/ettun-remote-port-slot-v1")
  second=$(<"$second_runtime/ettun-remote-port-slot-v1")
  repeated=$(<"$repeated_runtime/ettun-remote-port-slot-v1")
  if [[ $first =~ ^[0-9]+$ && $second =~ ^[0-9]+$ &&
    $first -le 818 && $second -le 818 ]]; then
    _pass "ettun remote slot: both assignments are canonical"
  else
    _fail "ettun remote slot: both assignments are canonical"
  fi
  if [[ $first != "$second" ]]; then
    _pass "ettun remote slot: declaration-order legs are disjoint"
  else
    _fail "ettun remote slot: declaration-order legs are disjoint"
  fi
  if [[ $first != 0 && $first != 1 && $second != 0 && $second != 1 ]]; then
    _pass "ettun remote slot: declared endpoints are excluded"
  else
    _fail "ettun remote slot: declared endpoints are excluded"
  fi
  _assert_eq "ettun remote slot: assignment is independent of prepare order" \
    "$first" "$repeated"

  {
    printf '%s\n' \
      $'version\t1' \
      $'generation\tgeneration.slot-exhausted' \
      $'target\tnone' \
      $'profile\tdemo' \
      $'leg\trelay\tettun'
    for ((slot = 0; slot < 819; slot++)); do
      port=$((49152 + slot))
      printf 'set\tfixed-%s\tlocal-forward\t%s:127.0.0.1:22\n' \
        "$slot" "$port"
    done
  } >"$manifest"
  status=0
  _fwdports_ettun_assign_remote_port_slot "$manifest" relay \
    "$tmp/exhausted" 2>"$error" || status=$?
  _assert_exit "ettun remote slot: exhaustion fails before launch" 1 "$status"
  _assert_contains "ettun remote slot: exhaustion is actionable" \
    'no remote port slot is available' "$(<"$error")"
  _assert_not_exists "ettun remote slot: exhaustion publishes nothing" \
    "$tmp/exhausted"

  {
    printf '%s\n' \
      $'version\t1' \
      $'generation\tgeneration.slot-endpoint-exhausted' \
      $'target\tnone' \
      $'profile\tdemo' \
      $'leg\trelay\tettun'
    for ((slot = 0; slot < 819; slot++)); do
      port=$((49152 + slot))
      if ((slot % 2 == 0)); then
        direction=local-forward
      else
        direction=remote-forward
      fi
      printf 'set\tfixed-%s\t%s\t127.0.0.1:18080:127.0.0.1:%s\n' \
        "$slot" "$direction" "$port"
    done
  } >"$manifest"
  status=0
  _fwdports_ettun_assign_remote_port_slot "$manifest" relay \
    "$tmp/endpoint-exhausted" 2>"$error" || status=$?
  _assert_exit \
    "ettun remote slot: destination endpoint exhaustion fails before launch" \
    1 "$status"
  _assert_contains \
    "ettun remote slot: destination endpoint exhaustion is actionable" \
    'no remote port slot is available' "$(<"$error")"
  _assert_not_exists \
    "ettun remote slot: destination endpoint exhaustion publishes nothing" \
    "$tmp/endpoint-exhausted"
}


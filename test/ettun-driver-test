  generation=$tmp/generation
  resolved=$tmp/resolved
  log=$tmp/order.log
  tmux_marker=$tmp/tmux-created
  error=$tmp/error
  mkdir -p "$generation/legs"
  chmod 0700 "$generation" "$generation/legs"
  printf '%s\n' $'leg\tfirst\tettun' $'leg\tsecond\tettun' \
    >"$resolved"
  cp "$resolved" "$generation/manifest"
  chmod 0600 "$resolved" "$generation/manifest"

  set +e
  (
    fwdports_builtin_validate_profile_ports() { return 0; }
    fwdports_driver_is_builtin() { return 0; }
    fwdports_builtin_prepare() {
      printf 'validate:%s\n' "$2" >>"$log"
    }
    fwdports_builtin_interactive_prepare() {
      printf 'prepare:%s\n' "$2" >>"$log"
      [[ $2 != second ]] || return 72
    }
    fwdports_tmux_create_session() {
      : >"$tmux_marker"
      printf '%s\t%s\n' session pane
    }
    _fwdports_start_generation /fixture/tmux /fixture/socket "$tmp" \
      "$tmp" "$tmp" "$generation" digest "$resolved" ''
  ) 2>"$error"
  status=$?
  set -e

  _assert_exit "ettun foreground ordering: preparation failure aborts start" \
    1 "$status"
  _assert_eq "ettun foreground ordering: all validation precedes prompts" \
    $'validate:first\nvalidate:second\nprepare:first\nprepare:second' \
    "$(<"$log")"
  _assert_not_exists \
    "ettun foreground ordering: failed prompt creates no tmux session" \
    "$tmux_marker"
}


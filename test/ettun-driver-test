missing_dependency_case() {
  local tmp output error status
  tmp=$(_tmpdir) || return 1
  output=$tmp/source
  error=$tmp/error

  set +e
  fwdports_ettun_resolve "$tmp/not-installed" "$output" 2>"$error"
  status=$?
  set -e

  _assert_exit "ettun dependency: missing executable fails early" 1 "$status"
  _assert_contains "ettun dependency: diagnostic names the missing command" \
    "ettun executable is not available" "$(<"$error")"
  _assert_not_exists "ettun dependency: failed resolution publishes nothing" \
    "$output"
}

resolve_case() {
  local tmp fake unsupported output error status expected_digest content=''
  tmp=$(_tmpdir) || return 1
  fake=$tmp/ettun
  output=$tmp/source
  error=$tmp/error
  write_fake_ettun "$fake"

  set +e
  fwdports_ettun_resolve "$fake" "$output" 2>"$error"
  status=$?
  set -e
  [[ ! -f $output ]] || content=$(<"$output")
  expected_digest=$(_fwdports_sha256_file "$fake")

  _assert_exit "ettun dependency: compatible executable resolves" 0 "$status"
  _assert_contains "ettun dependency: records canonical path" \
    $'path\t'"$fake" "$content"
  _assert_contains "ettun dependency: records immutable digest" \
    $'digest\t'"$expected_digest" "$content"
  _assert_contains "ettun dependency: records file identity" $'identity\t' \
    "$content"
  _assert_eq "ettun dependency: compatible executable emits no diagnostic" \
    "" "$(<"$error")"

  unsupported=$tmp/ettun-without-slot-contract
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'if [[ ${1:-} == --help ]]; then' \
    '  printf "Usage: ettun VIA LOCAL_PORT TARGET TARGET_PORT\n" >&2' \
    '  exit 0' \
    'fi' \
    'exit 0' >"$unsupported"
  chmod 0700 "$unsupported"
  rm -f "$output"
  status=0
  fwdports_ettun_resolve "$unsupported" "$output" 2>"$error" || status=$?
  _assert_exit "ettun dependency: old slot contract is rejected" 1 "$status"
  _assert_contains "ettun dependency: required slot contract is actionable" \
    'remote-port-slot-v1 contract' "$(<"$error")"
  _assert_not_exists "ettun dependency: unsupported version publishes nothing" \
    "$output"
}

local_dependencies_case() {
  local tmp fake_bin error status test_python_path hostile marker
  local launcher_dir launcher resolved
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  error=$tmp/error
  test_python_path=$(python3 -c \
    'import os, sys; print(os.path.realpath(sys.executable))') || return 1
  mkdir -p "$fake_bin"

  set +e
  (
    _fwdports_ettun_command_path() {
      [[ $1 != gzip ]] || return 1
      printf '/fixture/%s\n' "$1"
    }
    fwdports_ettun_validate_local_dependencies
  ) 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun dependencies: a missing local command fails early" \
    1 "$status"
  _assert_contains "ettun dependencies: diagnostic names the missing command" \
    "ettun local dependency is not available: gzip" "$(<"$error")"

  set +e
  (
    _fwdports_ettun_platform_is_darwin() { return 0; }
    _fwdports_canonical_executable() {
      [[ $1 != python3 ]] || return 1
      return 1
    }
    _fwdports_ettun_command_path() {
      printf '/fixture/%s\n' "$1"
    }
    fwdports_ettun_validate_local_dependencies
  ) 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun dependencies: missing Darwin Python fails early" \
    1 "$status"
  _assert_contains \
    "ettun dependencies: diagnostic names the missing Darwin Python" \
    "ettun local dependency is not available on macOS: python3" \
    "$(<"$error")"

  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'exit 2' >"$fake_bin/python3"
  chmod 0700 "$fake_bin/python3"
  set +e
  (
    _fwdports_ettun_platform_is_darwin() { return 0; }
    _fwdports_canonical_executable() {
      [[ $1 != python3 ]] || {
        printf '%s\n' "$fake_bin/python3"
        return 0
      }
      return 1
    }
    _fwdports_ettun_command_path() {
      printf '/fixture/%s\n' "$1"
    }
    fwdports_ettun_validate_local_dependencies
  ) 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun dependencies: incompatible Darwin Python fails early" \
    1 "$status"
  _assert_contains \
    "ettun dependencies: incompatible Darwin Python is actionable" \
    "ettun macOS session enumerator probe failed" \
    "$(<"$error")"

  chmod 0722 "$fake_bin/python3"
  set +e
  (
    _fwdports_ettun_platform_is_darwin() { return 0; }
    _fwdports_canonical_executable() {
      [[ $1 != python3 ]] || {
        printf '%s\n' "$fake_bin/python3"
        return 0
      }
      return 1
    }
    _fwdports_ettun_command_path() {
      printf '/fixture/%s\n' "$1"
    }
    fwdports_ettun_validate_local_dependencies
  ) 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun dependencies: writable Darwin Python fails early" \
    1 "$status"
  _assert_contains \
    "ettun dependencies: writable Darwin Python is actionable" \
    "ettun macOS session interpreter has untrusted metadata" \
    "$(<"$error")"

  set +e
  (
    _fwdports_ettun_platform_is_darwin() { return 1; }
    _fwdports_ettun_command_path() {
      printf '/fixture/%s\n' "$1"
    }
    fwdports_ettun_validate_local_dependencies
  ) 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun dependencies: Linux needs no Python enumerator" 0 \
    "$status"
  _assert_eq "ettun dependencies: Linux dependency check is quiet" "" \
    "$(<"$error")"

  hostile=$tmp/hostile-python
  marker=$tmp/sitecustomize-loaded
  mkdir -p "$hostile"
  printf '%s\n' \
    'import os' \
    'with open(os.environ["FWDPORTS_TEST_SITE_MARKER"], "w") as marker:' \
    '    marker.write("loaded")' >"$hostile/sitecustomize.py"

  set +e
  (
    _fwdports_ettun_platform_is_darwin() { return 0; }
    _fwdports_canonical_executable() {
      [[ $1 != python3 && $1 != "$test_python_path" ]] || {
        printf '%s\n' "$test_python_path"
        return 0
      }
      return 1
    }
    _fwdports_ettun_command_path() {
      printf '/fixture/%s\n' "$1"
    }
    PYTHONPATH=$hostile FWDPORTS_TEST_SITE_MARKER=$marker \
      fwdports_ettun_validate_local_dependencies
  ) 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun dependencies: complete local toolset succeeds" 0 \
    "$status"
  _assert_eq "ettun dependencies: complete toolset is quiet" "" \
    "$(<"$error")"
  _assert_not_exists \
    "ettun dependencies: isolated Python ignores ambient startup" "$marker"

  set +e
  (
    _fwdports_ettun_platform_is_darwin() { return 0; }
    _fwdports_canonical_executable() {
      case $1 in
        python3) return 1 ;;
        /usr/bin/python3)
          printf '%s\n' "$test_python_path"
          return 0
          ;;
        "$test_python_path")
          printf '%s\n' "$test_python_path"
          return 0
          ;;
        *) return 1 ;;
      esac
    }
    _fwdports_ettun_command_path() {
      printf '/fixture/%s\n' "$1"
    }
    fwdports_ettun_validate_local_dependencies
  ) 2>"$error"
  status=$?
  set -e
  _assert_exit \
    "ettun dependencies: macOS system Python bypasses an unsafe PATH entry" \
    0 "$status"
  _assert_eq "ettun dependencies: system Python fallback is quiet" "" \
    "$(<"$error")"

  launcher_dir=$tmp/python-launcher
  launcher=$launcher_dir/python3
  mkdir -p "$launcher_dir"
  chmod 0700 "$launcher_dir"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'exec "$FWDPORTS_TEST_PYTHON_BACKEND" "$@"' >"$launcher"
  chmod 0700 "$launcher"
  resolved=$(PATH="$launcher_dir:/usr/bin:/bin" \
    FWDPORTS_TEST_PYTHON_BACKEND=$test_python_path \
    _fwdports_ettun_session_python_resolve) || return 1
  _assert_contains \
    "ettun dependencies: stable launcher records its exact Python backend" \
    "$test_python_path" "$resolved"
  _assert_not_contains \
    "ettun dependencies: lifecycle metadata excludes the ambient launcher" \
    "$launcher" "$resolved"
}

untrusted_python_backend_case() {
  local tmp safe_dir unsafe_dir launcher backend error status
  tmp=$(_tmpdir) || return 1
  safe_dir=$tmp/safe
  unsafe_dir=$tmp/unsafe
  launcher=$safe_dir/python3
  backend=$unsafe_dir/python3
  error=$tmp/error
  mkdir -p "$safe_dir" "$unsafe_dir"
  chmod 0700 "$safe_dir"
  chmod 0777 "$unsafe_dir"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "$FWDPORTS_TEST_PYTHON_BACKEND"' >"$launcher"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$backend"
  chmod 0700 "$launcher" "$backend"

  set +e
  PATH="$safe_dir:/usr/bin:/bin" \
    FWDPORTS_TEST_PYTHON_BACKEND=$backend \
    _fwdports_ettun_session_python_resolve 2>"$error"
  status=$?
  set -e

  _assert_exit "ettun dependency: untrusted Python backend is rejected" \
    1 "$status"
  _assert_contains \
    "ettun dependency: untrusted backend diagnostic names its candidate" \
    "$backend" "$(<"$error")"
  _assert_contains \
    "ettun dependency: untrusted backend diagnostic names its writable ancestor" \
    "$unsafe_dir (mode 777)" "$(<"$error")"
}

darwin_group_writable_python_backend_case() {
  local tmp safe_dir group_dir launcher backend output error status
  tmp=$(_tmpdir) || return 1
  safe_dir=$tmp/safe
  group_dir=$tmp/group
  launcher=$safe_dir/python3
  backend=$group_dir/python3
  output=$tmp/output
  error=$tmp/error
  mkdir -p "$safe_dir" "$group_dir"
  chmod 0700 "$safe_dir"
  chmod 0770 "$group_dir"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "$FWDPORTS_TEST_PYTHON_BACKEND"' >"$launcher"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$backend"
  chmod 0700 "$launcher" "$backend"

  set +e
  (
    _fwdports_platform_is_darwin() { return 0; }
    _fwdports_stat_group() { printf '80\n'; }
    id() {
      if [[ ${1:-} == -G ]]; then
        printf '%s 80\n' "$(command id -G)"
      else
        command id "$@"
      fi
    }
    PATH="$safe_dir:/usr/bin:/bin" \
      FWDPORTS_TEST_PYTHON_BACKEND=$backend \
      _fwdports_ettun_session_python_resolve >"$output" 2>"$error"
  )
  status=$?
  set -e

  _assert_exit \
    "ettun dependency: Darwin accepts a backend under the admin group" \
    0 "$status"
  _assert_contains \
    "ettun dependency: Darwin records the admin-group backend" \
    "$backend" "$(<"$output")"
  _assert_eq "ettun dependency: admin-group backend is quiet" "" \
    "$(<"$error")"

  chmod 0777 "$group_dir"
  set +e
  (
    _fwdports_platform_is_darwin() { return 0; }
    _fwdports_stat_group() { printf '80\n'; }
    id() {
      if [[ ${1:-} == -G ]]; then
        printf '%s 80\n' "$(command id -G)"
      else
        command id "$@"
      fi
    }
    PATH="$safe_dir:/usr/bin:/bin" \
      FWDPORTS_TEST_PYTHON_BACKEND=$backend \
      _fwdports_ettun_session_python_resolve >"$output" 2>"$error"
  )
  status=$?
  set -e
  _assert_exit \
    "ettun dependency: Darwin still rejects a world-writable backend parent" \
    1 "$status"

  chmod 0770 "$group_dir"
  set +e
  (
    _fwdports_platform_is_darwin() { return 0; }
    PATH="$safe_dir:/usr/bin:/bin" \
      FWDPORTS_TEST_PYTHON_BACKEND=$backend \
      _fwdports_ettun_session_python_resolve >"$output" 2>"$error"
  )
  status=$?
  set -e
  _assert_exit \
    "ettun dependency: Darwin rejects a non-admin group-writable parent" \
    1 "$status"
}


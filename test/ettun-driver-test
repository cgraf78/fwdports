# shellcheck source=../lib/fwdports/drivers.sh
source "$ROOT/lib/fwdports/drivers.sh"
# shellcheck source=../lib/fwdports/core.sh
source "$ROOT/lib/fwdports/core.sh"

wait_for_path() {
  local path=$1 attempts=0

  while [[ ! -e $path && $attempts -lt 200 ]]; do
    sleep 0.01
    attempts=$((attempts + 1))
  done
  [[ -e $path ]]
}


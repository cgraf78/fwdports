    FWDPORTS_SSH_COMMAND=$fake_ssh \
    FWDPORTS_TEST_SSH_CONFIG=$ssh_config \
    fwdports_builtin_prepare "$manifest" relay ettun "$runtime" '' \
    >/dev/null 2>"$error" || return 1

  set +e
  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_ETTUN_LOG=$log \
    FWDPORTS_TEST_ETTUN_STATUS=23 ETTUN_TRANSPORT=ambient-adapter \
    ETTUN_CLIENT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    ETTUN_BOOTSTRAP_TIMEOUT=999 ETTUN_REMOTE_PORT_SLOT_V1=999 \
    ETTUN_TRANSPORT_SINGLE_INVOCATION_V1=1 \
    "$runtime/ettun-gate" 2>"$error"
  status=$?
  set -e
  before=$(<"$log")

  _assert_exit "ettun gate: foreground status is preserved" 23 "$status"
  _assert_contains "ettun gate: selects the hardened ET dependency gate" \
    "ETTUN_ET=$runtime/ettun-et-gate" "$before"
  _assert_contains "ettun gate: ambient transport override is removed" \
    "ETTUN_TRANSPORT=" "$before"
  _assert_not_contains "ettun gate: ambient transport cannot replace ET" \
    "ambient-adapter" "$before"
  _assert_contains "ettun gate: temporary state is generation-private" \
    "TMPDIR=$runtime/ettun-tmp" "$before"
  slot=$(<"$runtime/ettun-remote-port-slot-v1")
  _assert_contains "ettun gate: selects the generation remote port slot" \
    "ETTUN_REMOTE_PORT_SLOT_V1=$slot" "$before"
  _assert_not_contains "ettun gate: ambient slot cannot replace selection" \
    'ETTUN_REMOTE_PORT_SLOT_V1=999' "$before"
  _assert_contains "ettun gate: stock transport clears ambient single-invocation" \
    'ETTUN_TRANSPORT_SINGLE_INVOCATION_V1=' "$before"
  _assert_contains "ettun gate: fixed route arguments reach the engine" \
    $'ARG=gateway.example.net\nARG=18080\nARG=desktop.example.net\nARG=3389' \
    "$before"

  for corruption in nonnumeric out-of-range multiline; do
    case $corruption in
      nonnumeric)
        label=nonnumeric
        printf '%s\n' invalid >"$runtime/ettun-remote-port-slot-v1"
        ;;
      out-of-range)
        label=out-of-range
        printf '%s\n' 819 >"$runtime/ettun-remote-port-slot-v1"
        ;;
      multiline)
        label=multiline
        printf '%s\n' "$slot" "$slot" \
          >"$runtime/ettun-remote-port-slot-v1"
        ;;
    esac
    status=0
    PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_ETTUN_LOG=$log \
      FWDPORTS_TEST_ETTUN_STATUS=0 "$runtime/ettun-gate" \
      2>"$error" || status=$?
    _assert_exit "ettun gate: $label slot fails closed" 78 "$status"
    _assert_eq "ettun gate: $label slot launches no engine bytes" \
      "$before" "$(<"$log")"
  done
  rm -f "$runtime/ettun-remote-port-slot-v1"
  status=0
  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_ETTUN_LOG=$log \
    FWDPORTS_TEST_ETTUN_STATUS=0 "$runtime/ettun-gate" \
    2>"$error" || status=$?
  _assert_exit "ettun gate: missing slot fails closed" 78 "$status"
  _assert_eq "ettun gate: missing slot launches no engine bytes" \
    "$before" "$(<"$log")"
  printf '%s\n' "$slot" >"$runtime/ettun-remote-port-slot-v1"

  : >"$runtime/ettun-argv"
  set +e
  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_ETTUN_LOG=$log \
    FWDPORTS_TEST_ETTUN_STATUS=0 "$runtime/ettun-gate" 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun gate: empty argv fails with generation drift" 78 "$status"
  _assert_eq "ettun gate: empty argv launches no engine bytes" "$before" \
    "$(<"$log")"

  printf '%s\n' gateway.example.net --local 18080 desktop.example.net 3389 \
    --reverse 22022 127.0.0.1 22 >"$runtime/ettun-argv"
  set +e
  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_ETTUN_LOG=$log \
    FWDPORTS_TEST_ETTUN_STATUS=23 "$runtime/ettun-gate" 2>"$error"
  status=$?
  set -e
  _assert_exit "ettun gate: explicit mixed route is accepted" 23 "$status"
  _assert_contains "ettun gate: complete mixed route reaches the engine" \
    $'ARG=gateway.example.net\nARG=--local\nARG=18080\nARG=desktop.example.net\nARG=3389\nARG=--reverse\nARG=22022\nARG=127.0.0.1\nARG=22' \
    "$(<"$log")"
  before=$(<"$log")

  printf '\n# drift\n' >>"$fake_ettun"
  set +e
  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_ETTUN_LOG=$log \
    FWDPORTS_TEST_ETTUN_STATUS=0 "$runtime/ettun-gate" 2>"$error"
  status=$?
  set -e
  after=$(<"$log")
  _assert_exit "ettun gate: executable drift fails closed" 78 "$status"
  _assert_eq "ettun gate: drift launches no replacement bytes" "$before" \
    "$after"
}


#!/usr/bin/env bash
# Case callbacks are passed by name to the shared harness.
# shellcheck disable=SC2329
# Single-quoted fixture lines are expanded only by the child process.
# shellcheck disable=SC2016
# Exercise the shared harness through the same case-filter interface used by
# every behavior suite. A misspelled case must fail instead of silently running
# nothing, because filtered cases are the unit of the repository's TDD loop.

set -u

TEST_DIR=$(CDPATH='' cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
TEST_CASE=${1:-}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"

case_filter_case() {
  _assert_eq "case filter: selected case runs" "case-filter" "$CURRENT_TEST_CASE"
}

UNSELECTED_RAN=0
unselected_case() {
  UNSELECTED_RAN=1
  _pass "case filter: second case runs without a filter"
}

suite_executability_case() {
  local tmp output status=0
  tmp=$(_tmpdir) || return 1
  cp "$TEST_DIR/run" "$tmp/run"
  printf '%s\n' 'echo "started blocked suite"' 'exit 17' >"$tmp/blocked-test"
  printf '%s\n' 'echo "started healthy suite"' >"$tmp/healthy-test"
  chmod 0600 "$tmp/blocked-test"
  chmod 0700 "$tmp/healthy-test"

  output=$("$BASH" "$tmp/run" 2>&1) || status=$?
  _assert_exit "suite runner: a nonexecutable suite fails the run" 1 "$status"
  _assert_contains "suite runner: reports which suite needs its executable bit" \
    "suite is not executable: $tmp/blocked-test" "$output"
  _assert_not_contains "suite runner: never starts a nonexecutable suite" \
    'started blocked suite' "$output"
  _assert_contains "suite runner: still runs the next executable suite" \
    'started healthy suite' "$output"

  chmod 0700 "$tmp/blocked-test"
  status=0
  output=$("$BASH" "$tmp/run" 2>&1) || status=$?
  _assert_exit "suite runner: preserves an executable suite's failure" 17 "$status"
  _assert_contains "suite runner: starts the newly executable suite" \
    'started blocked suite' "$output"

  chmod 0600 "$tmp/blocked-test" "$tmp/healthy-test"
  status=0
  output=$("$BASH" "$tmp/run" 2>&1) || status=$?
  _assert_exit "suite runner: fails when all suites lack the executable bit" 1 "$status"
  _assert_contains "suite runner: identifies the second nonexecutable suite" \
    "suite is not executable: $tmp/healthy-test" "$output"
  _assert_not_contains "suite runner: distinguishes nonexecutable suites from no suites" \
    'no executable test suites found' "$output"
}

canonical_tmpdir_case() {
  local tmp physical logical output
  tmp=$(_tmpdir) || return 1
  physical=$tmp/physical
  logical=$tmp/logical
  mkdir -p "$physical"
  ln -s "$physical" "$logical"

  output=$(TMPDIR="$logical/" FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash -c 'source "$FWDPORTS_TEST_HARNESS"; _FWDPORTS_TEST_SUMMARIZED=1
      printf "%s\n" "$_FWDPORTS_TEST_TMP_BASE"')

  _assert_eq "temporary base: resolves symlinks and trailing separators" \
    "$physical" "$output"
}

colon_tmpdir_case() {
  local tmp logical output status=0
  tmp=$(_tmpdir) || return 1
  mkdir "$tmp/has:colon"
  logical=$tmp/logical
  ln -s "$tmp/has:colon" "$logical"
  output=$(TMPDIR="$logical" FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    "$BASH" -c 'source "$FWDPORTS_TEST_HARNESS"; _FWDPORTS_TEST_SUMMARIZED=1' 2>&1) || status=$?
  _assert_exit "temporary base: rejects a physical path that cannot be used in PATH" 1 "$status"
  _assert_contains "temporary base: explains how to select a usable TMPDIR" \
    'TMPDIR must resolve to a path without a colon' "$output"
}

private_umask_case() {
  local output
  output=$(FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" bash -c \
    'umask 002; source "$FWDPORTS_TEST_HARNESS"; _FWDPORTS_TEST_SUMMARIZED=1
    umask')

  _assert_eq "test harness: protects all fixture creation by default" \
    "0077" "$output"
}

nonzero_callback_case() {
  local tmp child output status marker
  tmp=$(_tmpdir) || return 1
  child=$tmp/nonzero-callback
  output=$tmp/output
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'setup_fails() { return 1; }' \
    'run_case setup-fails setup_fails' \
    '_test_summary' \
    >"$child"
  chmod 0700 "$child"

  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e

  _assert_exit "case callback: an unasserted failure fails the suite" \
    1 "$status"
  _assert_contains "case callback: failure identifies the case" \
    "case callback failed: setup-fails" "$(<"$output")"

  marker=$tmp/continued-after-failure
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'setup_fails_early() {' \
    '  set -e' \
    '  false' \
    '  : >"$FWDPORTS_TEST_CONTINUED_MARKER"' \
    '}' \
    'run_case setup-fails-early setup_fails_early' \
    '_test_summary' \
    >"$child"
  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    FWDPORTS_TEST_CONTINUED_MARKER=$marker \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e
  _assert_exit "case callback: errexit setup failure fails immediately" \
    1 "$status"
  _assert_not_exists "case callback: does not continue after setup failure" \
    "$marker"
}

signal_status_case() {
  local tmp child output status
  tmp=$(_tmpdir) || return 1
  child=$tmp/interrupted
  output=$tmp/output
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'interrupted() { _pass "before signal"; kill -TERM $$; }' \
    'run_case interrupted interrupted' \
    '_test_summary' \
    >"$child"
  chmod 0700 "$child"

  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e
  # Inside a trap `$?` belongs to the interrupted command, so a signal that
  # arrives after passing work could otherwise report success.
  _assert_exit "signal status: a TERMed suite exits 143" 143 "$status"
}

missing_summary_case() {
  local tmp child output status
  tmp=$(_tmpdir) || return 1
  child=$tmp/missing-summary
  output=$tmp/output
  # Stands in for an abort that Bash 3.2 reports as status 0, such as an
  # unbound variable under nounset: a suite must not pass without a summary.
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'passes() { _pass "before abort"; }' \
    'run_case passes passes' \
    'exit 0' \
    >"$child"
  chmod 0700 "$child"

  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e
  _assert_exit "missing summary: a suite that skips its summary fails" 1 \
    "$status"
  _assert_contains "missing summary: names the missing summary" \
    "suite exited before its summary" "$(<"$output")"
}

nounset_abort_case() {
  local tmp child output status
  tmp=$(_tmpdir) || return 1
  child=$tmp/nounset-abort
  output=$tmp/output
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'aborts() {' \
    '  set -e' \
    '  local -a empty=()' \
    '  _pass "before abort"' \
    '  if ((BASH_VERSINFO[0] < 4)); then' \
    '    _assert_eq "empty array" "" "${empty[*]}"' \
    '  else' \
    '    : "$fwdports_test_unset_variable"' \
    '  fi' \
    '}' \
    'run_case aborts aborts' \
    '_test_summary' \
    >"$child"
  chmod 0700 "$child"

  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e
  # Under Bash 3.2 this mirrors the abort that once passed the stock macOS job,
  # an empty array expanded under nounset and errexit, which that Bash reports
  # as success, so there the guard must be what fails it. Newer Bash allows an
  # empty array, so the child aborts on an unset scalar, which fails by itself.
  if [[ $status -ne 0 ]]; then
    _pass "nounset abort: a suite that aborts mid-case fails"
  else
    _fail "nounset abort: a suite that aborts mid-case fails"
  fi
  _assert_not_contains "nounset abort: never reaches its summary" \
    "Results:" "$(<"$output")"
  if ((BASH_VERSINFO[0] < 4)); then
    _assert_contains "nounset abort: Bash 3.2 fails it through the guard" \
      "suite exited before its summary" "$(<"$output")"
  fi
}

zombie_liveness_case() {
  local tmp holder zombie_pid='' index=0 stopped=0
  if ! command -v python3 >/dev/null 2>&1; then
    _pass "process liveness: python3 is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  # The child exits at once while its parent sleeps without reaping it: the
  # state an orphaned fixture reaches under a container PID 1 that never
  # reaps. Teardown and the tmux cases must treat it as stopped.
  python3 -c 'import os, sys, time
pid = os.fork()
if pid == 0:
    os._exit(0)
sys.stdout.write(f"{pid}\n")
sys.stdout.flush()
time.sleep(30)' >"$tmp/zombie.pid" 2>/dev/null &
  holder=$!
  while [[ ! -s "$tmp/zombie.pid" && $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  [[ -s "$tmp/zombie.pid" ]] && zombie_pid=$(<"$tmp/zombie.pid")
  index=0
  while [[ -n "$zombie_pid" && $index -lt 200 ]]; do
    if ! _test_process_live "$zombie_pid"; then
      stopped=1
      break
    fi
    sleep 0.01
    index=$((index + 1))
  done

  if [[ -n "$zombie_pid" ]] && kill -0 "$zombie_pid" 2>/dev/null; then
    _pass "process liveness: fixture holds a kill -0-visible zombie"
  else
    _fail "process liveness: fixture holds a kill -0-visible zombie"
  fi
  _assert_eq "process liveness: a zombie is not live" 1 "$stopped"
  if _test_process_live "$holder"; then
    _pass "process liveness: a running process is live"
  else
    _fail "process liveness: a running process is live"
  fi
  kill -KILL "$holder" 2>/dev/null
  wait "$holder" 2>/dev/null
  return 0
}

# Write a child suite that records its harness root, then starts an isolated
# tmux server under that root, records the server and pane PIDs, and runs the
# given case-tail lines. The pane ignores HUP and TERM so only group
# escalation stops it, which is the shape that survives a bare kill-server.
write_tmux_child() {
  local child=$1
  shift
  {
    cat <<'EOF'
#!/usr/bin/env bash
set -u
source "$FWDPORTS_TEST_HARNESS"
printf '%s\n' "$_FWDPORTS_TEST_TMP_ROOT" >"$FWDPORTS_TEST_ROOT_RECORD"
starts_server() {
  local socket
  socket=$(_tmpdir)/tmux.sock || return 1
  TMUX='' "$FWDPORTS_TEST_TMUX" -S "$socket" -f /dev/null new-session -d \
    -- sh -c 'trap "" HUP TERM; while :; do sleep 1; done' || return 1
  TMUX='' "$FWDPORTS_TEST_TMUX" -S "$socket" display-message -p \
    '#{pid} #{pane_pid}' >"$FWDPORTS_TEST_PIDS" || return 1
EOF
    printf '  %s\n' "$@"
    printf '}\n'
    cat <<'EOF'
run_case starts-server starts_server
_test_summary
EOF
  } >"$child"
  chmod 0700 "$child"
}

# True while the recorded server or any member of its pane group can run.
# Stopped fixtures may linger as unreaped zombies in containers.
tmux_child_alive() {
  [[ -n "$CHILD_SERVER_PID" ]] && _test_process_live "$CHILD_SERVER_PID" &&
    return 0
  [[ -n "$CHILD_PANE_PID" ]] && _test_process_live "-$CHILD_PANE_PID"
}

# Run a child written by write_tmux_child, then wait for its recorded
# processes to disappear. The child's root sits directly in this suite's root
# rather than in a case directory: macOS limits socket paths to about 104
# bytes, and a second level of case nesting overflows that under its long
# /private/var temporary base.
run_tmux_child() {
  local tmp=$1 child=$2 attempts=0
  set +e
  TMPDIR=$_FWDPORTS_TEST_TMP_ROOT \
    FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    FWDPORTS_TEST_TMUX="$_FWDPORTS_TEST_TMUX" FWDPORTS_TEST_PIDS=$tmp/pids \
    FWDPORTS_TEST_ROOT_RECORD=$tmp/root \
    bash "$child" >"$tmp/output" 2>&1
  CHILD_STATUS=$?
  CHILD_OUTPUT=$(<"$tmp/output")
  CHILD_SERVER_PID=
  CHILD_PANE_PID=
  [[ -s "$tmp/pids" ]] &&
    read -r CHILD_SERVER_PID CHILD_PANE_PID <"$tmp/pids"
  [[ $CHILD_SERVER_PID =~ ^[0-9]+$ ]] || CHILD_SERVER_PID=
  [[ $CHILD_PANE_PID =~ ^[0-9]+$ ]] || CHILD_PANE_PID=
  CHILD_ALIVE=1
  while [[ $attempts -lt 200 ]]; do
    if ! tmux_child_alive; then
      CHILD_ALIVE=0
      break
    fi
    sleep 0.01
    attempts=$((attempts + 1))
  done
  # Without a recorded root, point at a directory that exists so the
  # root-removal assertion fails instead of passing vacuously.
  CHILD_ROOT=$tmp
  [[ -s "$tmp/root" ]] && CHILD_ROOT=$(<"$tmp/root")
  reap_tmux_child
}

# A failing assertion must not become the leak it describes. Signal only the
# recorded pane group, and only after confirming it still is the fixture; the
# server exits by itself once its only pane is gone.
reap_tmux_child() {
  [[ $CHILD_ALIVE -eq 1 ]] || return 0
  if [[ -n "$CHILD_PANE_PID" ]] &&
    ps -o args= -p "$CHILD_PANE_PID" 2>/dev/null |
    grep -F -q -- 'while :; do sleep 1; done'; then
    kill -KILL -- "-$CHILD_PANE_PID" 2>/dev/null
  fi
  return 0
}

tmux_available() {
  [[ -n "$_FWDPORTS_TEST_TMUX" ]]
}

leaked_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux leak: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/leaks-server
  write_tmux_child "$child" '_pass "server started"'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux leak: a passing case that leaks a server fails" \
    1 "$CHILD_STATUS"
  _assert_contains "tmux leak: failure names the leaking case" \
    "case leaked tmux server: starts-server" "$CHILD_OUTPUT"
  _assert_not_contains "tmux leak: exit teardown does not report it again" \
    "stopped leaked tmux server" "$CHILD_OUTPUT"
  _assert_ne "tmux leak: fixture recorded its processes" "" "$CHILD_PANE_PID"
  _assert_eq "tmux leak: server and HUP-ignoring pane are stopped" \
    0 "$CHILD_ALIVE"
  _assert_not_exists "tmux leak: temporary root is still removed" \
    "$CHILD_ROOT"
}

aborted_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux abort: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/aborts-with-server
  # Exiting from inside the case skips run_case's own check, so only the
  # EXIT trap can stop the server before the root is deleted.
  write_tmux_child "$child" 'exit 3'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux abort: preserves the primary exit status" \
    3 "$CHILD_STATUS"
  _assert_contains "tmux abort: teardown reports the stopped server" \
    "stopped leaked tmux server:" "$CHILD_OUTPUT"
  _assert_ne "tmux abort: fixture recorded its processes" "" "$CHILD_PANE_PID"
  _assert_eq "tmux abort: server and HUP-ignoring pane are stopped" \
    0 "$CHILD_ALIVE"
  _assert_not_exists "tmux abort: temporary root is still removed" \
    "$CHILD_ROOT"
}

interrupted_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux interrupt: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/interrupted-with-server
  write_tmux_child "$child" 'kill -TERM $$'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux interrupt: reports the TERM status" 143 "$CHILD_STATUS"
  _assert_contains "tmux interrupt: teardown reports the stopped server" \
    "stopped leaked tmux server:" "$CHILD_OUTPUT"
  _assert_ne "tmux interrupt: fixture recorded its processes" "" \
    "$CHILD_PANE_PID"
  _assert_eq "tmux interrupt: server and HUP-ignoring pane are stopped" \
    0 "$CHILD_ALIVE"
  _assert_not_exists "tmux interrupt: temporary root is still removed" \
    "$CHILD_ROOT"
}

clean_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux clean: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/stops-server
  write_tmux_child "$child" \
    'TMUX= "$FWDPORTS_TEST_TMUX" -S "$socket" kill-server' \
    'read -r _ pane <"$FWDPORTS_TEST_PIDS"' \
    'kill -KILL -- "-$pane"' \
    '_pass "server stopped"'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux clean: a case that stops its server passes" \
    0 "$CHILD_STATUS"
  _assert_not_contains "tmux clean: reports no leak" "leaked tmux server" \
    "$CHILD_OUTPUT"
  _assert_eq "tmux clean: fixture processes are gone" 0 "$CHILD_ALIVE"
}

dead_tmux_case() {
  local tmp socket pane worker group attempts status state scenario
  if ! tmux_available; then
    _pass "dead tmux pane: tmux is unavailable here"
    return 0
  fi
  for scenario in surviving-worker departed-worker; do
    tmp=$(_tmpdir) || return 1
    socket=$tmp/tmux.sock
    cat >"$tmp/worker" <<'EOF'
#!/usr/bin/env bash
trap '' HUP TERM
printf '%s\n' "$$" >"$1"
deadline=$((SECONDS + 10))
until [[ -e $2 || $SECONDS -ge $deadline ]]; do sleep 0.01; done
EOF
    chmod 0700 "$tmp/worker"
    pane=$(_test_tmux "$socket" new-session -d -P -F '#{pane_id}' -- sh -c '
      "$1/worker" "$1/pid" "$1/stop-worker" </dev/null >/dev/null 2>&1 &
      until [ -e "$1/stop-pane" ]; do sleep 0.01; done
    ' sh "$tmp") || return 1
    _test_tmux "$socket" set-option -w remain-on-exit on || return 1
    group=$(_test_tmux "$socket" display-message -p -t "$pane" '#{pane_pid}') || return 1
    attempts=0
    until [[ -s $tmp/pid || $attempts -ge 200 ]]; do
      sleep 0.01
      attempts=$((attempts + 1))
    done
    [[ -s $tmp/pid && $group =~ ^[1-9][0-9]*$ ]] || return 1
    worker=$(<"$tmp/pid")
    [[ $worker =~ ^[1-9][0-9]*$ ]] || return 1
    record_test_tmux_worker "$socket" "$pane" "$worker" || return 1
    : >"$tmp/stop-pane"
    attempts=0
    state=
    until [[ $state == 1/ || $attempts -ge 200 ]]; do
      state=$(_test_tmux "$socket" display-message -p -t "$pane" '#{pane_dead}/#{pane_pid}')
      sleep 0.01
      attempts=$((attempts + 1))
    done
    _assert_eq "dead tmux pane: $scenario has no tmux pane PID" 1/ "$state"
    if [[ $scenario == departed-worker ]]; then
      : >"$tmp/stop-worker"
      _test_tmux_groups_gone 200 _test_process_live "$group" || return 1
    fi

    status=0
    kill_test_server "$socket" || status=$?
    _assert_exit "dead tmux pane: $scenario teardown is verifiable" 0 "$status"
    if _test_process_live "$worker"; then
      _fail "dead tmux pane: $scenario leaves no runnable worker"
      # Let a failing implementation clean up only the prepared fixture.
      : >"$tmp/stop-worker"
      _test_tmux_groups_gone 200 _test_process_live "$group" || return 1
    else
      _pass "dead tmux pane: $scenario leaves no runnable worker"
    fi
  done
}

departing_tmux_worker_case() {
  local wire_dead=${1:-1} tmp socket output status=0
  tmp=$(_tmpdir) || return 1
  socket=$tmp/tmux.sock
  printf '%s\n' $'42:10\t123\t124\tlinux:100' >"$socket.pane.1"
  output=$(
    _test_tmux() {
      # Bash 3.2 misparses this fixture's case patterns inside $().
      if [[ $2 == list-panes ]]; then
        printf '42:10 %%1 %s \n' "$wire_dead"
      elif [[ $2 == kill-server ]]; then
        : >"$tmp/server-stopped"
      elif [[ $2 == list-sessions ]]; then
        return 1
      else
        return 2
      fi
    }
    ps() {
      if [[ ! -e $tmp/worker-exited ]]; then
        printf '1 1 S\n124 123 S\n'
      elif [[ ! -e $tmp/last-child-observed ]]; then
        : >"$tmp/last-child-observed"
        printf '1 1 S\n125 123 S\n'
      else
        printf '1 1 S\n'
      fi
    }
    _test_tmux_worker_identity() {
      : >"$tmp/worker-exited"
      return 1
    }
    kill() { : >"$tmp/signal-sent"; }
    kill_test_server "$socket" 2>&1
  ) || status=$?
  _assert_exit "tmux teardown: worker exit during inspection is verifiable" 0 "$status"
  _assert_eq "tmux teardown: verified departure has no diagnostic" "" "$output"
  _assert_file "tmux teardown: worker exited after initial census" "$tmp/worker-exited"
  _assert_file "tmux teardown: census observed the departing worker's last child" \
    "$tmp/last-child-observed"
  _assert_file "tmux teardown: verified departure stops the server" "$tmp/server-stopped"
  _assert_not_exists "tmux teardown: verified departure sends no worker signal" "$tmp/signal-sent"
}

closing_tmux_pane_case() {
  # tmux 3.8 clears the PID when the terminal closes, before marking the pane dead.
  departing_tmux_worker_case 0
}

unverifiable_tmux_case() {
  local tmp socket scenario output status
  tmp=$(_tmpdir) || return 1
  socket=$tmp/tmux.sock
  for scenario in unreadable-census unreadable-recensus changed-worker \
    missing-worker unregistered-closing-pane malformed-live-pid; do
    if [[ $scenario == unregistered-closing-pane ]]; then
      rm -f -- "$socket.pane.1"
    else
      printf '%s\n' $'42:10\t123\t124\tlinux:100' >"$socket.pane.1"
    fi
    status=0
    output=$(
      _test_tmux() {
        if [[ $2 == list-panes ]]; then
          if [[ $scenario == unregistered-closing-pane ]]; then
            printf '42:10 %%1 0 \n'
          elif [[ $scenario == malformed-live-pid ]]; then
            printf '42:10 %%1 0 invalid\n'
          else
            printf '42:10 %%1 1 \n'
          fi
        else
          : >"$tmp/$scenario.tmux"
          return 1
        fi
      }
      ps() {
        [[ $scenario != unreadable-census ]] || return 19
        if [[ $scenario == unreadable-recensus && -e $tmp/$scenario.identity ]]; then
          : >"$tmp/recensus-failed"
          return 19
        fi
        printf '124 123 S\n'
      }
      _test_tmux_worker_identity() {
        : >"$tmp/$scenario.identity"
        [[ $scenario != missing-worker ]] || return 1
        printf 'linux:200\n'
      }
      kill() { : >"$tmp/$scenario.signal"; }
      kill_test_server "$socket" 2>&1
    ) || status=$?
    _assert_exit "tmux teardown: rejects $scenario" 2 "$status"
    _assert_contains "tmux teardown: diagnosis names $scenario socket" \
      "could not verify tmux teardown: $socket" "$output"
    _assert_not_exists "tmux teardown: $scenario sends no process signal" \
      "$tmp/$scenario.signal"
    _assert_not_exists "tmux teardown: $scenario preserves the tmux server" \
      "$tmp/$scenario.tmux"
  done
  _assert_file "tmux teardown: failed identity is followed by a census" "$tmp/recensus-failed"
}

partial_socket_scan_case() {
  local tmp output status=0 socket
  tmp=$(_tmpdir) || return 1
  socket=$tmp/$'line\nbreak with spaces.sock'
  output=$(FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" FWDPORTS_TEST_TMUX_BIN=true \
    "$BASH" -c '
      source "$FWDPORTS_TEST_HARNESS"
      find() {
        # Fail only the case scan. The child trap still runs a complete scan.
        [[ ! -e "$1/already-scanned" ]] || return 0
        : >"$1/already-scanned"
        case "$4" in
          -print0) printf "%s\0" "$FWDPORTS_TEST_SOCKET" ;;
          -print) printf "%s\n" "$FWDPORTS_TEST_SOCKET" ;;
        esac
        return 19
      }
      _stop_test_tmux_server() { printf "%s" "$1" >>"$FWDPORTS_TEST_STOPPED"; }
      succeeds() { _pass "fixture ran"; }
      FWDPORTS_TEST_SOCKET=$1 FWDPORTS_TEST_STOPPED=$2
      run_case fixture succeeds
      _test_summary
    ' bash "$socket" "$tmp/stopped" 2>&1) || status=$?

  _assert_exit "case socket scan: fails on partial discovery" 1 "$status"
  _assert_contains "case socket scan: identifies the incomplete case" \
    'case could not scan tmux sockets: fixture' "$output"
  _assert_eq "case socket scan: still stops an exactly named discovered socket" \
    "$socket" "$(<"$tmp/stopped")"
}

exit_socket_scan_case() {
  local tmp outcome output status expected root
  tmp=$(_tmpdir) || return 1
  for outcome in success failure signal; do
    case "$outcome" in
      success) expected=1 ;;
      failure) expected=17 ;;
      signal) expected=143 ;;
    esac
    status=0
    output=$(TMPDIR="$tmp" FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
      FWDPORTS_TEST_TMUX_BIN=true "$BASH" -c '
        source "$FWDPORTS_TEST_HARNESS"
        find() { return 19; }
        _FWDPORTS_TEST_SUMMARIZED=1
        printf "%s\n" "$_FWDPORTS_TEST_TMP_ROOT" >"$2"
        case "$1" in
          success) exit 0 ;;
          failure) exit 17 ;;
          signal) kill -TERM "$$" ;;
        esac
      ' bash "$outcome" "$tmp/root" 2>&1) || status=$?
    root=$(<"$tmp/root")
    _assert_exit "exit socket scan: reports incomplete discovery after $outcome" \
      "$expected" "$status"
    _assert_contains "exit socket scan: identifies the retained root after $outcome" \
      "could not scan tmux sockets during teardown: $root" "$output"
    if [[ -d "$root" ]]; then
      _pass "exit socket scan: leaves any undiscovered sockets reachable after $outcome"
    else
      _fail "exit socket scan: leaves any undiscovered sockets reachable after $outcome"
    fi
  done
}


#!/usr/bin/env bash
# Case callbacks are passed by name to the shared harness.
# shellcheck disable=SC2329
# Single-quoted fixture lines are expanded only by the child process.
# shellcheck disable=SC2016
# Exercise the shared harness through the same case-filter interface used by
# every behavior suite. A misspelled case must fail instead of silently running
# nothing, because filtered cases are the unit of the repository's TDD loop.

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
TEST_CASE=${1:-}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"

case_filter_case() {
  _assert_eq "case filter: selected case runs" "case-filter" "$CURRENT_TEST_CASE"
}

UNSELECTED_RAN=0
unselected_case() {
  UNSELECTED_RAN=1
  _pass "case filter: second case runs without a filter"
}

canonical_tmpdir_case() {
  local tmp physical logical output
  tmp=$(_tmpdir) || return 1
  physical=$tmp/physical
  logical=$tmp/logical
  mkdir -p "$physical"
  ln -s "$physical" "$logical"

  output=$(TMPDIR="$logical/" FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash -c 'source "$FWDPORTS_TEST_HARNESS"; printf "%s\n" "$_FWDPORTS_TEST_TMP_BASE"')

  _assert_eq "temporary base: resolves symlinks and trailing separators" \
    "$physical" "$output"
}

private_umask_case() {
  local output
  output=$(FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" bash -c \
    'umask 002; source "$FWDPORTS_TEST_HARNESS"; umask')

  _assert_eq "test harness: protects all fixture creation by default" \
    "0077" "$output"
}

nonzero_callback_case() {
  local tmp child output status marker
  tmp=$(_tmpdir) || return 1
  child=$tmp/nonzero-callback
  output=$tmp/output
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'setup_fails() { return 1; }' \
    'run_case setup-fails setup_fails' \
    '_test_summary' \
    >"$child"
  chmod 0700 "$child"

  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e

  _assert_exit "case callback: an unasserted failure fails the suite" \
    1 "$status"
  _assert_contains "case callback: failure identifies the case" \
    "case callback failed: setup-fails" "$(<"$output")"

  marker=$tmp/continued-after-failure
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'setup_fails_early() {' \
    '  set -e' \
    '  false' \
    '  : >"$FWDPORTS_TEST_CONTINUED_MARKER"' \
    '}' \
    'run_case setup-fails-early setup_fails_early' \
    '_test_summary' \
    >"$child"
  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    FWDPORTS_TEST_CONTINUED_MARKER=$marker \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e
  _assert_exit "case callback: errexit setup failure fails immediately" \
    1 "$status"
  _assert_not_exists "case callback: does not continue after setup failure" \
    "$marker"
}

signal_status_case() {
  local tmp child output status
  tmp=$(_tmpdir) || return 1
  child=$tmp/interrupted
  output=$tmp/output
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -u' \
    'source "$FWDPORTS_TEST_HARNESS"' \
    'interrupted() { _pass "before signal"; kill -TERM $$; }' \
    'run_case interrupted interrupted' \
    '_test_summary' \
    >"$child"
  chmod 0700 "$child"

  set +e
  FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    bash "$child" >"$output" 2>&1
  status=$?
  set -e
  # Inside a trap `$?` belongs to the interrupted command, so a signal that
  # arrives after passing work could otherwise report success.
  _assert_exit "signal status: a TERMed suite exits 143" 143 "$status"
}

zombie_liveness_case() {
  local tmp holder zombie_pid='' index=0 stopped=0
  if ! command -v python3 >/dev/null 2>&1; then
    _pass "process liveness: python3 is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  # The child exits at once while its parent sleeps without reaping it: the
  # state an orphaned fixture reaches under a container PID 1 that never
  # reaps. Teardown and the tmux cases must treat it as stopped.
  python3 -c 'import os, sys, time
pid = os.fork()
if pid == 0:
    os._exit(0)
sys.stdout.write(f"{pid}\n")
sys.stdout.flush()
time.sleep(30)' >"$tmp/zombie.pid" 2>/dev/null &
  holder=$!
  while [[ ! -s "$tmp/zombie.pid" && $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  [[ -s "$tmp/zombie.pid" ]] && zombie_pid=$(<"$tmp/zombie.pid")
  index=0
  while [[ -n "$zombie_pid" && $index -lt 200 ]]; do
    if ! _test_process_live "$zombie_pid"; then
      stopped=1
      break
    fi
    sleep 0.01
    index=$((index + 1))
  done

  if [[ -n "$zombie_pid" ]] && kill -0 "$zombie_pid" 2>/dev/null; then
    _pass "process liveness: fixture holds a kill -0-visible zombie"
  else
    _fail "process liveness: fixture holds a kill -0-visible zombie"
  fi
  _assert_eq "process liveness: a zombie is not live" 1 "$stopped"
  if _test_process_live "$holder"; then
    _pass "process liveness: a running process is live"
  else
    _fail "process liveness: a running process is live"
  fi
  kill -KILL "$holder" 2>/dev/null
  wait "$holder" 2>/dev/null
  return 0
}

# Write a child suite that records its harness root, then starts an isolated
# tmux server under that root, records the server and pane PIDs, and runs the
# given case-tail lines. The pane ignores HUP and TERM so only group
# escalation stops it, which is the shape that survives a bare kill-server.
write_tmux_child() {
  local child=$1
  shift
  {
    cat <<'EOF'
#!/usr/bin/env bash
set -u
source "$FWDPORTS_TEST_HARNESS"
printf '%s\n' "$_FWDPORTS_TEST_TMP_ROOT" >"$FWDPORTS_TEST_ROOT_RECORD"
starts_server() {
  local socket
  socket=$(_tmpdir)/tmux.sock || return 1
  TMUX='' "$FWDPORTS_TEST_TMUX" -S "$socket" -f /dev/null new-session -d \
    -- sh -c 'trap "" HUP TERM; while :; do sleep 1; done' || return 1
  TMUX='' "$FWDPORTS_TEST_TMUX" -S "$socket" display-message -p \
    '#{pid} #{pane_pid}' >"$FWDPORTS_TEST_PIDS" || return 1
EOF
    printf '  %s\n' "$@"
    printf '}\n'
    cat <<'EOF'
run_case starts-server starts_server
_test_summary
EOF
  } >"$child"
  chmod 0700 "$child"
}

# True while the recorded server or any member of its pane group can run.
# Stopped fixtures may linger as unreaped zombies in containers.
tmux_child_alive() {
  [[ -n "$CHILD_SERVER_PID" ]] && _test_process_live "$CHILD_SERVER_PID" &&
    return 0
  [[ -n "$CHILD_PANE_PID" ]] && _test_process_live "-$CHILD_PANE_PID"
}

# Run a child written by write_tmux_child, then wait for its recorded
# processes to disappear. The child's root sits directly in this suite's root
# rather than in a case directory: macOS limits socket paths to about 104
# bytes, and a second level of case nesting overflows that under its long
# /private/var temporary base.
run_tmux_child() {
  local tmp=$1 child=$2 attempts=0
  set +e
  TMPDIR=$_FWDPORTS_TEST_TMP_ROOT \
    FWDPORTS_TEST_HARNESS="$TEST_DIR/lib/test.sh" \
    FWDPORTS_TEST_TMUX="$_FWDPORTS_TEST_TMUX" FWDPORTS_TEST_PIDS=$tmp/pids \
    FWDPORTS_TEST_ROOT_RECORD=$tmp/root \
    bash "$child" >"$tmp/output" 2>&1
  CHILD_STATUS=$?
  CHILD_OUTPUT=$(<"$tmp/output")
  CHILD_SERVER_PID=
  CHILD_PANE_PID=
  [[ -s "$tmp/pids" ]] &&
    read -r CHILD_SERVER_PID CHILD_PANE_PID <"$tmp/pids"
  [[ $CHILD_SERVER_PID =~ ^[0-9]+$ ]] || CHILD_SERVER_PID=
  [[ $CHILD_PANE_PID =~ ^[0-9]+$ ]] || CHILD_PANE_PID=
  CHILD_ALIVE=1
  while [[ $attempts -lt 200 ]]; do
    if ! tmux_child_alive; then
      CHILD_ALIVE=0
      break
    fi
    sleep 0.01
    attempts=$((attempts + 1))
  done
  # Without a recorded root, point at a directory that exists so the
  # root-removal assertion fails instead of passing vacuously.
  CHILD_ROOT=$tmp
  [[ -s "$tmp/root" ]] && CHILD_ROOT=$(<"$tmp/root")
  reap_tmux_child
}

# A failing assertion must not become the leak it describes. Signal only the
# recorded pane group, and only after confirming it still is the fixture; the
# server exits by itself once its only pane is gone.
reap_tmux_child() {
  [[ $CHILD_ALIVE -eq 1 ]] || return 0
  if [[ -n "$CHILD_PANE_PID" ]] &&
    ps -o args= -p "$CHILD_PANE_PID" 2>/dev/null |
    grep -F -q -- 'while :; do sleep 1; done'; then
    kill -KILL -- "-$CHILD_PANE_PID" 2>/dev/null
  fi
  return 0
}

tmux_available() {
  [[ -n "$_FWDPORTS_TEST_TMUX" ]]
}

leaked_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux leak: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/leaks-server
  write_tmux_child "$child" '_pass "server started"'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux leak: a passing case that leaks a server fails" \
    1 "$CHILD_STATUS"
  _assert_contains "tmux leak: failure names the leaking case" \
    "case leaked tmux server: starts-server" "$CHILD_OUTPUT"
  _assert_not_contains "tmux leak: exit teardown does not report it again" \
    "stopped leaked tmux server" "$CHILD_OUTPUT"
  _assert_ne "tmux leak: fixture recorded its processes" "" "$CHILD_PANE_PID"
  _assert_eq "tmux leak: server and HUP-ignoring pane are stopped" \
    0 "$CHILD_ALIVE"
  _assert_not_exists "tmux leak: temporary root is still removed" \
    "$CHILD_ROOT"
}

aborted_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux abort: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/aborts-with-server
  # Exiting from inside the case skips run_case's own check, so only the
  # EXIT trap can stop the server before the root is deleted.
  write_tmux_child "$child" 'exit 3'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux abort: preserves the primary exit status" \
    3 "$CHILD_STATUS"
  _assert_contains "tmux abort: teardown reports the stopped server" \
    "stopped leaked tmux server:" "$CHILD_OUTPUT"
  _assert_ne "tmux abort: fixture recorded its processes" "" "$CHILD_PANE_PID"
  _assert_eq "tmux abort: server and HUP-ignoring pane are stopped" \
    0 "$CHILD_ALIVE"
  _assert_not_exists "tmux abort: temporary root is still removed" \
    "$CHILD_ROOT"
}

interrupted_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux interrupt: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/interrupted-with-server
  write_tmux_child "$child" 'kill -TERM $$'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux interrupt: reports the TERM status" 143 "$CHILD_STATUS"
  _assert_contains "tmux interrupt: teardown reports the stopped server" \
    "stopped leaked tmux server:" "$CHILD_OUTPUT"
  _assert_ne "tmux interrupt: fixture recorded its processes" "" \
    "$CHILD_PANE_PID"
  _assert_eq "tmux interrupt: server and HUP-ignoring pane are stopped" \
    0 "$CHILD_ALIVE"
  _assert_not_exists "tmux interrupt: temporary root is still removed" \
    "$CHILD_ROOT"
}

clean_tmux_case() {
  local tmp child
  if ! tmux_available; then
    _pass "tmux clean: tmux is unavailable here"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  child=$tmp/stops-server
  write_tmux_child "$child" \
    'TMUX= "$FWDPORTS_TEST_TMUX" -S "$socket" kill-server' \
    'read -r _ pane <"$FWDPORTS_TEST_PIDS"' \
    'kill -KILL -- "-$pane"' \
    '_pass "server stopped"'
  run_tmux_child "$tmp" "$child"

  _assert_exit "tmux clean: a case that stops its server passes" \
    0 "$CHILD_STATUS"
  _assert_not_contains "tmux clean: reports no leak" "leaked tmux server" \
    "$CHILD_OUTPUT"
  _assert_eq "tmux clean: fixture processes are gone" 0 "$CHILD_ALIVE"
}

run_case case-filter case_filter_case
run_case unselected unselected_case
run_case canonical-tmpdir canonical_tmpdir_case
run_case private-umask private_umask_case
run_case nonzero-callback nonzero_callback_case
run_case signal-status signal_status_case
run_case zombie-liveness zombie_liveness_case
run_case leaked-tmux leaked_tmux_case
run_case aborted-tmux aborted_tmux_case
run_case interrupted-tmux interrupted_tmux_case
run_case clean-tmux clean_tmux_case
if [[ "$TEST_CASE" == case-filter ]]; then
  _assert_eq "case filter: other cases are skipped" 0 "$UNSELECTED_RAN"
fi
_test_summary

#!/usr/bin/env bash
# Named adapters for GNU/Linux and stock macOS command differences.
# Named cases and TEST_CASE are consumed indirectly by the shared harness.
# shellcheck disable=SC2329,SC2016,SC2034

set -u

TEST_DIR=$(CDPATH='' cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
TEST_CASE=${1:-}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"
# shellcheck source=../lib/fwdports/runtime.sh
source "$ROOT/lib/fwdports/runtime.sh"
# shellcheck source=../lib/fwdports/drivers.sh
source "$ROOT/lib/fwdports/drivers.sh"
# shellcheck source=../lib/fwdports/tmux.sh
source "$ROOT/lib/fwdports/tmux.sh"

bsd_stat_case() {
  local tmp fake_bin log output
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  log=$tmp/stat.log
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "$*" >>"$FWDPORTS_TEST_STAT_LOG"' \
    'if [[ ${1:-} == -c ]]; then exit 1; fi' \
    '[[ ${1:-} == -f && ${3:-} != -- ]] || exit 2' \
    'printf "1000 755 1 2 3 4\n"' >"$fake_bin/stat"
  chmod 0700 "$fake_bin/stat"
  output=$(PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_STAT_LOG=$log \
    _fwdports_stat_identity /tmp/example) || true
  _assert_eq "portability: BSD stat identity is parsed" \
    "1000 755 1 2 3 4" "$output"
  _assert_not_contains "portability: BSD stat receives no GNU terminator" \
    "-f %u %Lp %d %i %z %m --" "$(<"$log")"
}

canonicalization_case() {
  local tmp real link result
  tmp=$(_tmpdir) || return 1
  real=$tmp/real
  link=$tmp/link
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$real"
  chmod 0700 "$real"
  ln -s real "$link"
  result=$(_fwdports_canonical_executable "$link") || true
  _assert_eq "portability: canonicalization needs no readlink -f" \
    "$real" "$result"
}

stock_ssh_default_case() {
  local tmp fake_bin fake_ssh result override_result
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  fake_ssh=$fake_bin/ssh
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "OpenSSH_9.9p1 fake" >&2' \
    'exit 0' >"$fake_ssh"
  chmod 0700 "$fake_ssh"

  result=$(PATH="$fake_bin:/usr/bin:/bin" fwdports_ssh_command) ||
    return 1
  _assert_ne "portability: default SSH ignores PATH shims" \
    "$fake_ssh" "$result"
  _assert_contains "portability: default SSH selects stock binary" \
    "/ssh" "$result"

  override_result=$(FWDPORTS_SSH_COMMAND="$fake_ssh" \
    PATH="/usr/bin:/bin" fwdports_ssh_command) || return 1
  _assert_eq "portability: explicit SSH override remains honored" \
    "$fake_ssh" "$override_result"
}

termux_prefix_anchor_case() {
  local tmp outer prefix fake output error status
  tmp=$(_tmpdir) || return 1
  outer=$tmp/android-platform
  prefix=$outer/usr
  fake=$prefix/bin/ssh
  output=$tmp/identity
  error=$tmp/error
  mkdir -p "$prefix/bin"
  chmod 0777 "$outer"
  chmod 0700 "$prefix" "$prefix/bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "OpenSSH_9.9p1 test" >&2' \
    'exit 0' >"$fake"
  chmod 0700 "$fake"

  set +e
  PREFIX=$prefix PATH=$prefix/bin:/usr/bin:/bin \
    fwdports_ssh_resolve ssh "$output" 2>"$error"
  status=$?
  set -e

  _assert_exit "portability: generic PREFIX cannot excuse unsafe ancestor" \
    1 "$status"
  _assert_not_exists "portability: unsafe generic PREFIX publishes nothing" \
    "$output"

  status=0
  OSTYPE=linux-android PREFIX=/data/data/com.termux/files/usr \
    _fwdports_termux_prefix_anchor || status=$?
  _assert_exit "portability: real Termux PREFIX shape is recognized" 0 \
    "$status"
  set +e
  OSTYPE=linux-gnu PREFIX=/data/data/com.termux/files/usr \
    _fwdports_termux_prefix_anchor
  status=$?
  set -e
  _assert_exit "portability: path alone cannot impersonate Termux" 1 \
    "$status"
}

stock_macos_bash_ci_case() {
  local workflow stock_job stock_et_job
  workflow=$ROOT/.github/workflows/test.yml
  stock_job=$(awk '/^  macos-bash32:/ { found=1; next }
    found && /^  [a-z][a-z0-9-]*:/ { exit }
    found { print }' "$workflow")
  _assert_contains "portability CI: uses the standard Tests display name" \
    "name: Tests" "$(<"$workflow")"
  _assert_contains "portability CI: retry controller watches Tests" \
    "workflows: [Tests]" \
    "$(<"$ROOT/.github/workflows/retry-infrastructure.yml")"
  # shellcheck disable=SC2016 # Match the literal workflow command.
  _assert_contains "portability CI: desktop suites require the pinned tmux executable" \
    'test "$(command -v tmux)" = "$CI_TMUX_PINNED_BIN"' "$(<"$workflow")"
  _assert_contains "portability CI: Termux runs the suite with native tmux" \
    'termux-command: bash test/run' "$(<"$workflow")"

  # The shared matrix installs a current Homebrew Bash before running tests.
  # Keep a repository-owned gate for Apple's stock Bash so the documented
  # 3.2 compatibility promise cannot silently turn into a modern-Bash-only
  # claim when the shared workflow evolves.
  _assert_contains "portability CI: has a stock macOS Bash job" \
    "macos-bash32:" "$(<"$workflow")"
  _assert_contains "portability CI: stock job uses the shared installer" \
    'uses: cgraf78/actions/.github/actions/shell-ci-prereqs@' "$stock_job"
  _assert_contains "portability CI: stock job installs the pinned tmux" \
    'profiles: tmux-pinned' "$stock_job"
  # shellcheck disable=SC2016 # Match the literal workflow command.
  _assert_contains "portability CI: stock job requires its pinned executable" \
    'test "$(command -v tmux)" = "$CI_TMUX_PINNED_BIN"' "$stock_job"
  _assert_contains "portability CI: invokes stock /bin/bash" \
    'shell: /bin/bash {0}' "$(<"$workflow")"
  _assert_contains "portability CI: checks the Bash 3.2 version" \
    'BASH_VERSINFO[0]} -eq 3 && ${BASH_VERSINFO[1]} -eq 2' \
    "$(<"$workflow")"
  _assert_contains "portability CI: exercises the installed entrypoint" \
    '"$install_prefix/bin/fwdports" --version' "$(<"$workflow")"
  _assert_contains "portability CI: required gate includes Bash 3.2" \
    'needs: [shell, macos-bash32, stock-et-contract]' "$(<"$workflow")"
  _assert_contains "portability CI: required gate includes stock ET" \
    'test "$STOCK_ET_RESULT" = success' "$(<"$workflow")"
  stock_et_job=$(awk '/^  stock-et-contract:/ { found=1; next }
    found && /^  [a-z][a-z0-9-]*:/ { exit }
    found { print }' "$workflow")
  _assert_contains "portability CI: stock ET uses shared verified downloads" \
    'uses: cgraf78/actions/.github/actions/download-release-asset@' "$stock_et_job"
  _assert_contains "portability CI: stock ET pins the upstream ARM archive" \
    $'repository: MisterTea/EternalTerminal\n          tag: et-v7.0.0\n          asset: et_7.0.0-stable1_arm64.deb' "$stock_et_job"
  _assert_contains "portability CI: stock ET verifies the archive checksum" \
    'sha256: db31e467c879d8aae24e83a69e9e168e374e6f15ce7e28f64f8b5f53dacab742' "$stock_et_job"
}

bsd_ps_session_keyword_case() {
  local tmp fake_bin log snapshot members session_members
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  log=$tmp/ps.log
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "$*" >>"$FWDPORTS_TEST_PS_LOG"' \
    '[[ " $* " != *" sid= "* ]] || exit 2' \
    'if [[ " $* " == *" -e "* ]]; then' \
    '  printf "123 456 789 ?? S\n"' \
    'else' \
    '  printf "123 12 456 789 ?? S\n"' \
    'fi' \
    >"$fake_bin/ps"
  chmod 0700 "$fake_bin/ps"

  snapshot=$(PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_PS_LOG=$log \
    _fwdports_process_snapshot 123) || true
  members=$(PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_PS_LOG=$log \
    _fwdports_process_group_records 456) || true
  session_members=$(PATH="$fake_bin:/usr/bin:/bin" \
    FWDPORTS_TEST_PS_LOG=$log \
    _fwdports_process_session_records_portable 789) || true

  _assert_eq "portability: BSD ps snapshot records session identity" \
    $'12\t456\t789\t??\tS' "$snapshot"
  _assert_eq "portability: BSD ps group records session identity" \
    $'123\t789\t??\tS' "$members"
  _assert_eq "portability: portable session scan selects the exact SID" \
    $'123\t456\t??\tS' "$session_members"
  _assert_contains "portability: ps requests the shared sess keyword" \
    'sess=' "$(<"$log")"
  _assert_not_contains "portability: ps avoids Darwin-unsupported sid keyword" \
    'sid=' "$(<"$log")"
}

# A stat that accepts both flavors and logs each call, so the order of
# attempts is observable. Real BSD stat rejects `-c`, which made the old
# GNU-first order spend a guaranteed-failing fork per trust check on macOS.
# drivers.sh and runtime.sh each own a copy of the order (drivers.sh is
# sourced without runtime.sh elsewhere), so both are held to it here.
native_stat_order_case() {
  local tmp fake_bin log output helper
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  log=$tmp/stat.log
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "$1" >>"$FWDPORTS_TEST_STAT_LOG"' \
    '[[ ${1:-} != "${FWDPORTS_TEST_STAT_REJECT:-}" ]] || exit 1' \
    'if [[ ${1:-} == "${FWDPORTS_TEST_STAT_MULTILINE:-}" ]]; then' \
    '  printf "  File: \"/tmp/example\"\n    ID: 1\n"; exit 0' \
    'fi' \
    'printf "1000 755 1 2 3 4\n"' >"$fake_bin/stat"
  chmod 0700 "$fake_bin/stat"

  for helper in _fwdports_stat_identity _fwdports_runtime_identity; do
    : >"$log"
    output=$(OSTYPE=darwin23 PATH="$fake_bin:/usr/bin:/bin" \
      FWDPORTS_TEST_STAT_LOG=$log "$helper" /tmp/example) || true
    _assert_eq "portability: $helper parses Darwin stat" \
      "1000 755 1 2 3 4" "$output"
    _assert_eq "portability: $helper tries only Darwin's BSD flavor" \
      "-f" "$(<"$log")"

    : >"$log"
    output=$(OSTYPE=linux-gnu PATH="$fake_bin:/usr/bin:/bin" \
      FWDPORTS_TEST_STAT_LOG=$log "$helper" /tmp/example) || true
    _assert_eq "portability: $helper tries only the GNU flavor on Linux" \
      "-c" "$(<"$log")"

    # GNU coreutils can precede the system stat on a macOS PATH; the other
    # flavor remains the fallback, so the order never changes the result.
    : >"$log"
    output=$(OSTYPE=darwin23 PATH="$fake_bin:/usr/bin:/bin" \
      FWDPORTS_TEST_STAT_LOG=$log FWDPORTS_TEST_STAT_REJECT=-f \
      "$helper" /tmp/example) || true
    _assert_eq "portability: $helper falls back to GNU stat on Darwin" \
      "1000 755 1 2 3 4" "$output"
    _assert_eq "portability: $helper falls back after the native attempt" \
      $'-f\n-c' "$(<"$log")"

    # GNU reads `-f FORMAT` as --file-system plus a file operand; with a
    # file named like the format in the working directory it succeeds with
    # multi-line output, which must count as a failed attempt.
    : >"$log"
    output=$(OSTYPE=darwin23 PATH="$fake_bin:/usr/bin:/bin" \
      FWDPORTS_TEST_STAT_LOG=$log FWDPORTS_TEST_STAT_MULTILINE=-f \
      "$helper" /tmp/example) || true
    _assert_eq "portability: $helper rejects multi-line native output" \
      "1000 755 1 2 3 4" "$output"
  done
}

# Each executable resolution checks every ancestor; a fork per directory
# (plus `id -u` per walk) dominated start time. One stat process must cover
# the whole chain, and a failed batch must fall back to per-directory stat.
# The kernel UID is read once when the modules are sourced, so the walk
# itself must fork no `id -u`.
chain_walk_batch_stat_case() {
  local tmp fake_bin stat_log id_log real_stat executable status depth anchor
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  stat_log=$tmp/stat.log
  id_log=$tmp/id.log
  real_stat=$(command -v stat) || return 1
  mkdir -p "$fake_bin" "$tmp/a/b/c"
  executable=$tmp/a/b/c/tool
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$executable"
  chmod 0700 "$executable"
  # The fake counts path operands after the format so a batch is visible;
  # FWDPORTS_TEST_STAT_SINGLE rejects multi-path calls like a stat that
  # cannot batch.
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'operands=$(($# - 2)); [[ ${3:-} != -- ]] || operands=$((operands - 1))' \
    'printf "%s\n" "$operands" >>"$FWDPORTS_TEST_STAT_LOG"' \
    'if [[ -n ${FWDPORTS_TEST_STAT_SINGLE:-} && $operands -gt 1 ]]; then exit 1; fi' \
    'exec "$FWDPORTS_TEST_REAL_STAT" "$@"' >"$fake_bin/stat"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "$*" >>"$FWDPORTS_TEST_ID_LOG"' \
    'exec /usr/bin/id "$@"' >"$fake_bin/id"
  chmod 0700 "$fake_bin/stat" "$fake_bin/id"
  # The walk covers every ancestor up to /, or up to Termux's PREFIX trust
  # anchor when the suite runs inside Termux (its CI puts TMPDIR there).
  depth=$(printf '%s\n' "${executable%/*}" | awk -F/ '{ print NF }')
  if _fwdports_termux_prefix_anchor; then
    # The helper succeeds only in Termux, where PREFIX is an ambient contract.
    # shellcheck disable=SC2153
    anchor=$(cd -P -- "$PREFIX" && pwd -P) || return 1
    case "$executable" in
      "$anchor"/*)
        depth=$((depth - $(printf '%s\n' "$anchor" | awk -F/ '{ print NF }') + 1))
        ;;
    esac
  fi

  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_STAT_LOG=$stat_log \
    FWDPORTS_TEST_ID_LOG=$id_log FWDPORTS_TEST_REAL_STAT=$real_stat \
    _fwdports_executable_parent_chain_trusted "$executable"
  status=$?
  _assert_exit "portability: batched ancestor walk accepts a trusted chain" \
    0 "$status"
  _assert_eq "portability: one stat process covers every ancestor" \
    "$depth" "$(<"$stat_log")"
  _assert_not_contains "portability: ancestor walk forks no id -u" \
    "-u" "$(cat "$id_log" 2>/dev/null)"

  : >"$stat_log"
  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_STAT_LOG=$stat_log \
    FWDPORTS_TEST_ID_LOG=$id_log FWDPORTS_TEST_REAL_STAT=$real_stat \
    FWDPORTS_TEST_STAT_SINGLE=1 \
    _fwdports_executable_parent_chain_trusted "$executable"
  status=$?
  _assert_exit "portability: ancestor walk falls back to per-directory stat" \
    0 "$status"
  _assert_contains "portability: fallback stats one ancestor at a time" \
    $'\n1\n1\n' "$(<"$stat_log")"

  chmod 0777 "$tmp/a"
  PATH="$fake_bin:/usr/bin:/bin" FWDPORTS_TEST_STAT_LOG=$stat_log \
    FWDPORTS_TEST_ID_LOG=$id_log FWDPORTS_TEST_REAL_STAT=$real_stat \
    _fwdports_executable_parent_chain_trusted "$executable" \
    2>"$tmp/error"
  status=$?
  chmod 0700 "$tmp/a"
  _assert_exit "portability: batched walk still rejects a writable ancestor" \
    1 "$status"
  _assert_contains "portability: batched walk names the writable ancestor" \
    "$tmp/a (mode 777)" "$(<"$tmp/error")"
}

run_case bsd-stat bsd_stat_case
run_case native-stat-order native_stat_order_case
run_case chain-walk-batch-stat chain_walk_batch_stat_case
run_case canonicalization canonicalization_case
run_case stock-ssh-default stock_ssh_default_case
run_case termux-prefix-anchor termux_prefix_anchor_case
run_case stock-macos-bash-ci stock_macos_bash_ci_case
run_case bsd-ps-session-keyword bsd_ps_session_keyword_case
_test_summary

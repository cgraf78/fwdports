ettun_runner_force_case() {
  local tmp output error status worker_alive=0
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" ettun-runner-force || return 1
  output=$tmp/output
  error=$tmp/error

  # Two authenticated scans reach the force stage before the 60-second
  # fixture grace period even on platforms with expensive session queries.
  set +e
  fwdports_tmux_terminate_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_ROOT" \
    active "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" \
    2 0.02 ettun-session >"$output" 2>"$error"
  status=$?
  set -e
  wait_for_process_inert "$PROC_CHILD" 100 0.01 || worker_alive=1

  _assert_exit "ettun runner force stop: cleanup succeeds" 0 "$status"
  _assert_eq "ettun runner force stop: second stage reaches ettun once" 2 \
    "$(<"$PROC_LEADER_MARKER")"
  _assert_eq "ettun runner force stop: worker has no live execution" 0 \
    "$worker_alive"
  _assert_eq "ettun runner force stop: has no diagnostic" "" \
    "$(<"$error")"

  kill -KILL -- "-$PROC_CHILD" 2>/dev/null || true
  kill_test_server "$PROC_SOCKET"
}


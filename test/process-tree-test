  local tmp fake_bin output status
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  output=$tmp/output
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "4242 4242 4242 ? Z\n"' \
    >"$fake_bin/ps"
  chmod 0700 "$fake_bin/ps"

  set +e
  PATH="$fake_bin:/usr/bin:/bin" \
    _fwdports_process_group_live_records 4242 >"$output" 2>/dev/null
  status=$?
  set -e

  _assert_exit "zombie-only process group: is already empty" 1 "$status"
  _assert_eq "zombie-only process group: publishes no live members" \

darwin_ettun_session_survivor_case() {
  local tmp output error records status records_status worker_alive=0
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" ettun-leak || return 1
  output=$tmp/output
  error=$tmp/error
  records=$tmp/records

  set +e
  (
    _fwdports_tmux_platform_is_darwin() { return 0; }
    if [[ $OSTYPE != darwin* ]]; then
      # Non-Darwin ps dialects need not implement Darwin's output contract.
      # Keep actual kernel PIDs and getsid calls while fixing only the snapshot.
      ps() { darwin_session_ps_fixture "$@"; }
    fi
    fwdports_tmux_terminate_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_ROOT" \
      active "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" \
      3 0.02 ettun-session >"$output" 2>"$error"
  )
  status=$?
  set -e
  command kill -0 -- "$PROC_CHILD" 2>/dev/null && worker_alive=1
  set +e
  (
    _fwdports_tmux_platform_is_darwin() { return 0; }
    if [[ $OSTYPE != darwin* ]]; then
      ps() { darwin_session_ps_fixture "$@"; }
    fi
    _fwdports_process_session_records "$PROC_LEADER" "$PROC_EVIDENCE" \
      >"$records"
  )
  records_status=$?
  set -e

  _assert_exit "Darwin getsid cleanup: surviving worker fails closed" 74 \
    "$status"
  _assert_eq "Darwin getsid cleanup: detached worker remains observable" 1 \
    "$worker_alive"
  _assert_exit "Darwin getsid cleanup: session scan succeeds" 0 \
    "$records_status"
  _assert_contains "Darwin getsid cleanup: finds the original-session worker" \
    "$PROC_CHILD"$'\t'"$PROC_CHILD"$'\t?' "$(<"$records")"
  _assert_contains "Darwin getsid cleanup: retained state is actionable" \
    "recorded session remains" "$(<"$error")"

  kill -KILL -- "-$PROC_CHILD" 2>/dev/null || true
  kill_test_server "$PROC_SOCKET"
}


}

mixed_live_process_group_case() {
  local tmp fake_bin output status
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  output=$tmp/output
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "4242 4242 4242 ? Z\n4243 4242 4242 ? S\n"' \
    >"$fake_bin/ps"
  chmod 0700 "$fake_bin/ps"

  set +e
  PATH="$fake_bin:/usr/bin:/bin" \
    _fwdports_process_group_live_records 4242 >"$output" 2>/dev/null
  status=$?
  set -e

  _assert_exit "mixed process group: remains live" 0 "$status"
  _assert_eq "mixed process group: retains the live member only" \
    $'4243\t4242\t?\tS' "$(<"$output")"
}

list_panes_failure_case() {
  local tmp fake_tmux output error status
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" term || return 1
  fake_tmux=$tmp/tmux-fail-list
  output=$tmp/output
  error=$tmp/error
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'for arg in "$@"; do' \
    '  [[ $arg != list-panes ]] || exit 1' \
    'done' \
    'exec "$FWDPORTS_TEST_REAL_TMUX" "$@"' \
    >"$fake_tmux"
  chmod 0700 "$fake_tmux"

  set +e
  FWDPORTS_TEST_REAL_TMUX=$TMUX_BIN \
    fwdports_tmux_remove_generation_session "$fake_tmux" "$PROC_SOCKET" \
    "$PROC_GENERATION" "$PROC_DIGEST" fwdports \
    >"$output" 2>"$error"
  status=$?
  set -e

  _assert_exit "tmux pane enumeration failure: refuses session removal" 74 \
    "$status"
  if TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$PROC_SOCKET" -f /dev/null \
    has-session -t "$PROC_SESSION" 2>/dev/null; then
    _pass "tmux pane enumeration failure: preserves the live session"
  else
    _fail "tmux pane enumeration failure: preserves the live session"
  fi
  _assert_contains "tmux pane enumeration failure: is actionable" \
    "cannot enumerate tmux panes" "$(<"$error")"
  kill_test_server "$PROC_SOCKET"
}

run_case pane-identity pane_identity_case
run_case term-owned-group term_owned_group_case
run_case already-exited-owned-group already_exited_owned_group_case
run_case exited-before-escalation exited_before_escalation_case
run_case kill-escalation kill_escalation_case
run_case leader-missing leader_missing_case
run_case failed-process-enumeration failed_process_enumeration_case
run_case malformed-process-enumeration malformed_process_enumeration_case
run_case zombie-only-process-group zombie_only_process_group_case
run_case mixed-live-process-group mixed_live_process_group_case
run_case list-panes-failure list_panes_failure_case
_test_summary

#!/usr/bin/env bash
# Case callbacks and TEST_CASE are consumed indirectly by the shared harness.
# shellcheck disable=SC2329,SC2034
# Single-quoted fixture lines are expanded only by the child process.
# shellcheck disable=SC2016

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
TEST_CASE=${1:-}
TMUX_BIN=${FWDPORTS_TEST_TMUX_BIN:-$(command -v tmux)}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"
# shellcheck source=../lib/fwdports/runtime.sh
source "$ROOT/lib/fwdports/runtime.sh"
# shellcheck source=../lib/fwdports/tmux.sh
source "$ROOT/lib/fwdports/tmux.sh"

TMUX_TEST_HOME=$(_tmpdir)/home
TMUX_TEST_CONFIG=$TMUX_TEST_HOME/config
mkdir -p "$TMUX_TEST_HOME" "$TMUX_TEST_CONFIG"
chmod 0700 "$TMUX_TEST_HOME" "$TMUX_TEST_CONFIG"
export HOME=$TMUX_TEST_HOME XDG_CONFIG_HOME=$TMUX_TEST_CONFIG

file_mode() {
  local path=$1 mode
  if mode=$(stat -c '%a' -- "$path" 2>/dev/null); then
    printf '%s\n' "$mode"
  else
    stat -f '%Lp' "$path"
  fi
}

wait_for_file() {
  local path=$1 attempts=0
  while [[ ! -s "$path" && $attempts -lt 200 ]]; do
    sleep 0.01
    attempts=$((attempts + 1))
  done
  [[ -s "$path" ]]
}

wait_for_process_exit() {
  local pid=$1 attempts=$2 delay=$3 index=0
  while kill -0 "$pid" 2>/dev/null && [[ $index -lt $attempts ]]; do
    sleep "$delay"
    index=$((index + 1))
  done
  ! kill -0 "$pid" 2>/dev/null
}

kill_test_server() {
  local socket=$1
  TMUX='' TMUX_PANE='' "$TMUX_BIN" -S "$socket" -f /dev/null \
    kill-server 2>/dev/null || true
}

termination_fixture() {
  local tmp=$1 mode=$2 home state source start record
  home=$tmp/home
  state=$tmp/state
  source=$tmp/resolved-profile
  PROC_SOCKET=$tmp/tmux.sock
  PROC_IDS=$tmp/ids
  PROC_LEADER_MARKER=$tmp/leader-term
  PROC_CHILD_MARKER=$tmp/child-term
  PROC_SCRIPT=$tmp/process-tree
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"
  printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:80' \
    >"$source"
  chmod 0600 "$source"
  PROC_ROOT=$(HOME=$home XDG_STATE_HOME=$state fwdports_runtime_init) ||
    return 1
  PROC_GENERATION=$(fwdports_generation_create "$PROC_ROOT" "$source") ||
    return 1
  PROC_DIGEST=$(fwdports_generation_manifest_digest "$PROC_GENERATION") ||
    return 1
  mkdir -p "$PROC_GENERATION/legs/web"
  chmod 0700 "$PROC_GENERATION/legs" "$PROC_GENERATION/legs/web"
  PROC_EVIDENCE=$PROC_GENERATION/legs/web/pane

  case "$mode" in
    term)
      printf '%s\n' \
        '#!/usr/bin/env bash' \
        'ids=$1; leader_marker=$2; child_marker=$3' \
        'child_loop() {' \
        '  trap '\''printf "term\\n" >"$child_marker"; exit 0'\'' TERM' \
        '  trap '\'''\'' HUP' \
        '  while :; do sleep 0.02; done' \
        '}' \
        'child_loop &' \
        'child=$!' \
        'trap '\''printf "term\\n" >"$leader_marker"; wait "$child" 2>/dev/null; exit 0'\'' TERM' \
        'trap '\'''\'' HUP' \
        'printf "%s %s\\n" "$$" "$child" >"$ids"' \
        'while :; do sleep 0.02; done' \
        >"$PROC_SCRIPT"
      ;;
    stubborn | missing)
      printf '%s\n' \
        '#!/usr/bin/env bash' \
        'ids=$1' \
        'trap '\'''\'' TERM HUP' \
        '(trap '\'''\'' TERM HUP; while :; do sleep 0.02; done) &' \
        'child=$!' \
        'printf "%s %s\\n" "$$" "$child" >"$ids"' \
        'while :; do sleep 0.02; done' \
        >"$PROC_SCRIPT"
      ;;
    *) return 1 ;;
  esac
  chmod 0700 "$PROC_SCRIPT"
  record=$(fwdports_tmux_create_session "$TMUX_BIN" "$PROC_SOCKET" \
    fwdports "${PROC_GENERATION##*/}" "$tmp" "$PROC_SCRIPT" "$PROC_IDS" \
    "$PROC_LEADER_MARKER" "$PROC_CHILD_MARKER") || return 1
  IFS=$'\t' read -r PROC_SESSION PROC_PANE <<<"$record"
  wait_for_file "$PROC_IDS" || return 1
  read -r PROC_LEADER PROC_CHILD <"$PROC_IDS"
  fwdports_tmux_record_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_SESSION" \
    "$PROC_PANE" "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" ||
    return 1
  record=$(_fwdports_pane_evidence_read "$PROC_GENERATION" "$PROC_DIGEST" \
    "$PROC_EVIDENCE") || return 1
  IFS=$'\t' read -r _ _ _ _ _ _ PROC_PGID _ _ <<<"$record"
  start=$(_fwdports_process_start_identity "$$")
  fwdports_control_write "$PROC_GENERATION" "$PROC_DIGEST" running running \
    "$$" "$start" none || return 1
  fwdports_pointer_publish "$PROC_ROOT" active "$PROC_GENERATION" \
    "$PROC_DIGEST" || return 1
  fwdports_control_write "$PROC_GENERATION" "$PROC_DIGEST" stopping stopped \
    "$$" "$start" none || return 1
}

pane_identity_case() {
  local tmp home state source root generation digest socket fixture pid_file
  local release record session_id pane_id evidence content leader_pid
  tmp=$(_tmpdir) || return 1
  home=$tmp/home
  state=$tmp/state
  source=$tmp/resolved-profile
  socket=$tmp/tmux.sock
  fixture=$tmp/leader
  pid_file=$tmp/pid
  release=$tmp/release
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"
  printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:80' \
    >"$source"
  chmod 0600 "$source"
  root=$(HOME=$home XDG_STATE_HOME=$state fwdports_runtime_init)
  generation=$(fwdports_generation_create "$root" "$source")
  digest=$(fwdports_generation_manifest_digest "$generation")
  mkdir -p "$generation/legs/web"
  chmod 0700 "$generation/legs" "$generation/legs/web"
  evidence=$generation/legs/web/pane
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\\n" "$$" >"$1"' \
    'while [[ ! -e "$2" ]]; do sleep 0.01; done' \
    >"$fixture"
  chmod 0700 "$fixture"

  record=$(fwdports_tmux_create_session "$TMUX_BIN" "$socket" \
    fwdports "${generation##*/}" "$tmp" "$fixture" "$pid_file" "$release")
  IFS=$'\t' read -r session_id pane_id <<<"$record"
  wait_for_file "$pid_file" || true
  leader_pid=$(<"$pid_file")
  fwdports_tmux_record_pane "$TMUX_BIN" "$socket" "$session_id" \
    "$pane_id" "$generation" "$digest" "$evidence"
  content=$(<"$evidence")

  _assert_file "pane identity: publishes a regular evidence file" "$evidence"
  _assert_eq "pane identity: protects evidence" 600 \
    "$(file_mode "$evidence")"
  _assert_contains "pane identity: binds generation" \
    $'generation\t'"${generation##*/}" "$content"
  _assert_contains "pane identity: binds manifest digest" \
    $'manifest-digest\t'"$digest" "$content"
  _assert_contains "pane identity: records exact session" \
    $'session-id\t'"$session_id" "$content"
  _assert_contains "pane identity: records exact pane" \
    $'pane-id\t'"$pane_id" "$content"
  _assert_contains "pane identity: records the pane leader" \
    $'leader-pid\t'"$leader_pid" "$content"
  _assert_contains "pane identity: records process start identity" \
    $'leader-start\t' "$content"
  _assert_contains "pane identity: records terminal" $'tty\t' "$content"
  _assert_contains "pane identity: records session id" $'sid\t' "$content"
  _assert_contains "pane identity: records process group" $'pgid\t' "$content"

  : >"$release"
  kill_test_server "$socket"
}

term_owned_group_case() {
  local tmp output error status group_status
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" term || return 1
  output=$tmp/output
  error=$tmp/error

  set +e
  fwdports_tmux_terminate_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_ROOT" \
    active "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" \
    100 0.02 >"$output" 2>"$error"
  status=$?

  _assert_exit "process cleanup TERM: succeeds" 0 "$status"
  _assert_eq "process cleanup TERM: reports graceful termination" \
    "term" "$(<"$output")"
  _assert_eq "process cleanup TERM: leader receives signal" \
    "term" "$(<"$PROC_LEADER_MARKER")"
  _assert_eq "process cleanup TERM: child receives group signal" \
    "term" "$(<"$PROC_CHILD_MARKER")"
  if _fwdports_process_group_live_records "$PROC_PGID" \
    >/dev/null 2>&1; then
    group_status=0
  else
    group_status=$?
  fi
  if [[ $group_status -eq 1 ]]; then
    _pass "process cleanup TERM: leaves no live group member"
  else
    _fail "process cleanup TERM: leaves no live group member (inspection status $group_status)"
  fi
  _assert_eq "process cleanup TERM: has no diagnostic" "" "$(<"$error")"
  kill_test_server "$PROC_SOCKET"
}

already_exited_owned_group_case() {
  local tmp output error status
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" term || return 1
  output=$tmp/output
  error=$tmp/error

  # An external driver's graceful cleanup can make the pane exit after the
  # controller classified it as live but before core reaches TERM.  Requiring
  # the old leader to remain alive across that harmless race turns a completed
  # stop into an error.  Simulate that exact boundary while retaining the real
  # tmux and process-group evidence used in production.
  kill -TERM -- "-$PROC_PGID"
  _fwdports_wait_group_empty "$PROC_PGID" 100 0.02 || return 1

  set +e
  fwdports_tmux_terminate_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_ROOT" \
    active "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" \
    100 0.02 >"$output" 2>"$error"
  status=$?
  set -e

  _assert_exit "process cleanup already exited: succeeds" 0 "$status"
  _assert_eq "process cleanup already exited: reports no signal" \
    "gone" "$(<"$output")"
  _assert_eq "process cleanup already exited: has no diagnostic" \
    "" "$(<"$error")"
  kill_test_server "$PROC_SOCKET"
}

exited_before_escalation_case() {
  local tmp output error status
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" term || return 1
  output=$tmp/output
  error=$tmp/error

  # Force the narrow boundary where the final bounded TERM poll observed the
  # group as live, but the processes finish before the KILL revalidation.  The
  # subsequent exact pane and group checks must recognize completed cleanup;
  # treating it as lost ownership would make graceful shutdown timing flaky.
  set +e
  (
    _fwdports_wait_group_empty() {
      local pgid=$1 index=0 group_status verify_status
      while [[ $index -lt 200 ]]; do
        if _fwdports_process_group_live_records "$pgid" >/dev/null 2>&1; then
          group_status=0
        else
          group_status=$?
        fi
        [[ $group_status -ne 0 ]] && break
        sleep 0.01
        index=$((index + 1))
      done
      [[ $group_status -eq 1 ]] || return 2
      while [[ $index -lt 400 ]]; do
        if fwdports_tmux_verify_pane "$TMUX_BIN" "$PROC_SOCKET" \
          "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE"; then
          verify_status=0
        else
          verify_status=$?
        fi
        [[ $verify_status -ne 0 ]] && break
        sleep 0.01
        index=$((index + 1))
      done
      [[ $verify_status -eq 1 ]] || return 2
      return 1
    }
    fwdports_tmux_terminate_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_ROOT" \
      active "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" \
      1 0 >"$output" 2>"$error"
  )
  status=$?
  set -e

  _assert_exit "process cleanup late TERM exit: succeeds" 0 "$status"
  _assert_eq "process cleanup late TERM exit: reports TERM completion" \
    "term" "$(<"$output")"
  _assert_eq "process cleanup late TERM exit: has no diagnostic" \
    "" "$(<"$error")"
  kill_test_server "$PROC_SOCKET"
}

kill_escalation_case() {
  local tmp output error status group_status
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" stubborn || return 1
  output=$tmp/output
  error=$tmp/error

  set +e
  fwdports_tmux_terminate_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_ROOT" \
    active "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" \
    3 0.02 >"$output" 2>"$error"
  status=$?

  _assert_exit "process cleanup KILL: escalation succeeds" 0 "$status"
  _assert_eq "process cleanup KILL: reports escalation" \
    "kill" "$(<"$output")"
  if _fwdports_process_group_live_records "$PROC_PGID" \
    >/dev/null 2>&1; then
    group_status=0
  else
    group_status=$?
  fi
  if [[ $group_status -eq 1 ]]; then
    _pass "process cleanup KILL: leaves no live group member"
  else
    _fail "process cleanup KILL: leaves no live group member (inspection status $group_status)"
  fi
  _assert_eq "process cleanup KILL: has no diagnostic" "" "$(<"$error")"
  kill_test_server "$PROC_SOCKET"
}

leader_missing_case() {
  local tmp output error status child_alive=0
  tmp=$(_tmpdir) || return 1
  termination_fixture "$tmp" missing || return 1
  output=$tmp/output
  error=$tmp/error
  kill -KILL "$PROC_LEADER"
  wait_for_process_exit "$PROC_LEADER" 100 0.01 || true

  set +e
  fwdports_tmux_terminate_pane "$TMUX_BIN" "$PROC_SOCKET" "$PROC_ROOT" \
    active "$PROC_GENERATION" "$PROC_DIGEST" "$PROC_EVIDENCE" \
    3 0.02 >"$output" 2>"$error"
  status=$?
  kill -0 "$PROC_CHILD" 2>/dev/null && child_alive=1

  _assert_exit "process cleanup missing leader: fails closed" 74 "$status"
  _assert_eq "process cleanup missing leader: signals no survivor" \
    1 "$child_alive"
  _assert_not_exists "process cleanup missing leader: writes no TERM marker" \
    "$PROC_CHILD_MARKER"
  _assert_contains "process cleanup missing leader: diagnostic is actionable" \
    "recorded leader is no longer live" "$(<"$error")"

  kill -KILL "$PROC_CHILD" 2>/dev/null || true
  kill_test_server "$PROC_SOCKET"
}

failed_process_enumeration_case() {
  local tmp fake_bin output status
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  output=$tmp/output
  mkdir -p "$fake_bin"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 1' >"$fake_bin/ps"
  chmod 0700 "$fake_bin/ps"

  set +e
  PATH="$fake_bin:/usr/bin:/bin" \
    _fwdports_process_group_records "$$" >"$output" 2>/dev/null
  status=$?
  set -e

  _assert_exit "process enumeration failure: is not an empty group" 2 \
    "$status"
  _assert_eq "process enumeration failure: publishes no partial members" \
    "" "$(<"$output")"
}

malformed_process_enumeration_case() {
  local tmp fake_bin output status
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  output=$tmp/output
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "1 1 1 ? S\ntruncated row\n"' \
    >"$fake_bin/ps"
  chmod 0700 "$fake_bin/ps"

  set +e
  PATH="$fake_bin:/usr/bin:/bin" \
    _fwdports_process_group_records 1 >"$output" 2>/dev/null
  status=$?
  set -e

  _assert_exit "malformed process enumeration: fails closed" 2 "$status"
  _assert_eq "malformed process enumeration: publishes no partial members" \
    "" "$(<"$output")"
}


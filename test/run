#!/usr/bin/env bash
# Run suites sequentially. Several suites later own real tmux sockets and
# process groups, so avoiding cross-suite parallelism is part of isolation.

set -uo pipefail

TEST_DIR=$(CDPATH='' cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
status=0
found=0

for suite in "$TEST_DIR"/*-test; do
  [[ -f "$suite" ]] || continue
  found=1
  if [[ ! -x "$suite" ]]; then
    printf 'test/run: suite is not executable: %s\n' "$suite" >&2
    ((status != 0)) || status=1
    continue
  fi
  bash "$suite" || status=$?
done

if [[ "$found" -eq 0 ]]; then
  printf 'test/run: no executable test suites found\n' >&2
  exit 1
fi

exit "$status"

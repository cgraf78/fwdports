#!/usr/bin/env bash
# Case callbacks and TEST_CASE are consumed indirectly by the shared harness.
# shellcheck disable=SC2329,SC2034
# Single-quoted fixture lines are expanded only by the child process.
# shellcheck disable=SC2016

set -u

TEST_DIR=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=$(cd -P -- "$TEST_DIR/.." && pwd -P)
TEST_CASE=${1:-}

# shellcheck source=lib/test.sh
source "$TEST_DIR/lib/test.sh"
# shellcheck source=../lib/fwdports/runtime.sh
source "$ROOT/lib/fwdports/runtime.sh"

file_mode() {
  local path=$1 mode
  if mode=$(stat -c '%a' -- "$path" 2>/dev/null); then
    printf '%s\n' "$mode"
  else
    stat -f '%Lp' "$path"
  fi
}

pointer_fixture() {
  local tmp=$1 home state source
  local root generation digest
  home=$tmp/home
  state=$tmp/state
  source=$tmp/resolved-profile
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"
  printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:80' \
    >"$source"
  chmod 0600 "$source"
  root=$(HOME=$home XDG_STATE_HOME=$state fwdports_runtime_init) || return 1
  generation=$(fwdports_generation_create "$root" "$source") || return 1
  digest=$(fwdports_generation_manifest_digest "$generation") || return 1
  fwdports_control_write "$generation" "$digest" preparing running \
    none none unknown || return 1
  printf '%s\t%s\t%s\n' "$root" "$generation" "$digest"
}

private_root_case() {
  local tmp home state output error status runtime_root
  tmp=$(_tmpdir) || return 1
  home="$tmp/home"
  state="$tmp/state"
  output="$tmp/output"
  error="$tmp/error"
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"

  set +e
  HOME=$home XDG_STATE_HOME=$state \
    fwdports_runtime_init >"$output" 2>"$error"
  status=$?
  runtime_root=$(<"$output")

  _assert_exit "runtime root: initialization succeeds" 0 "$status"
  _assert_eq "runtime root: follows absolute XDG state home" \
    "$state/fwdports" "$runtime_root"
  if [[ -d "$runtime_root" && ! -L "$runtime_root" ]]; then
    _pass "runtime root: creates a regular directory"
  else
    _fail "runtime root: creates a regular directory"
  fi
  _assert_eq "runtime root: protects directory" 700 \
    "$(file_mode "$runtime_root")"
  _assert_eq "runtime root: no diagnostics" "" "$(<"$error")"
}


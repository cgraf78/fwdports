concurrent_contenders_case() {
  local tmp home state root out1 out2 status1 status2 combined candidate
  local contender1 contender2
  tmp=$(_tmpdir) || return 1
  home="$tmp/home"
  state="$tmp/state"
  out1="$tmp/out1"
  out2="$tmp/out2"
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"
  root=$(HOME=$home XDG_STATE_HOME=$state fwdports_runtime_init)

  (
    set +e
    fwdports_lock_acquire "$root" >"$out1" 2>"$tmp/err1"
    printf '%s\n' "$?" >"$tmp/status1"
  ) &
  contender1=$!
  (
    set +e
    fwdports_lock_acquire "$root" >"$out2" 2>"$tmp/err2"
    printf '%s\n' "$?" >"$tmp/status2"
  ) &
  contender2=$!
  wait "$contender1"
  wait "$contender2"
  status1=$(<"$tmp/status1")
  status2=$(<"$tmp/status2")
  combined=$(printf '%s\n%s\n' "$status1" "$status2" | sort -n)

  _assert_eq "owner lock: exactly one concurrent contender wins" \
    $'0\n75' "$combined"
  if [[ $status1 -eq 0 ]]; then
    candidate=$(<"$out1")
  else
    candidate=$(<"$out2")
  fi
  if [[ $(readlink "$root/lifecycle.lock" 2>/dev/null) == "lock-candidates/${candidate##*/}" ]]; then
    _pass "owner lock: winning contender owns fixed link"
  else
    _fail "owner lock: winning contender owns fixed link"
  fi
  fwdports_lock_release "$root" "$candidate"
}


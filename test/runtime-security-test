  if [[ ! -e "$root/pending" && ! -L "$root/pending" ]]; then
    _pass "active pointer: does not create pending implicitly"
  else
    _fail "active pointer: does not create pending implicitly"
  fi
  _assert_eq "active pointer: emits no diagnostic" "" "$(<"$error")"
}

tampered_pointer_case() {
  local tmp fixture root generation digest pointer error output status
  tmp=$(_tmpdir) || return 1

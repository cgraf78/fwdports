immutable_manifest_case() {
  local tmp home state root source generation manifest before after digest
  local generation2
  tmp=$(_tmpdir) || return 1
  home="$tmp/home"
  state="$tmp/state"
  source="$tmp/resolved-profile"
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"
  printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    $'set\tweb\tlocal-forward\t127.0.0.1:8080:127.0.0.1:80' \
    >"$source"
  chmod 0600 "$source"
  root=$(HOME=$home XDG_STATE_HOME=$state fwdports_runtime_init)

  generation=$(fwdports_generation_create "$root" "$source")
  manifest=$generation/manifest
  before=$(<"$manifest")
  digest=$(fwdports_generation_manifest_digest "$generation")

  if [[ -d "$generation" && ! -L "$generation" ]]; then
    _pass "generation manifest: final directory exists before publication"
  else
    _fail "generation manifest: final directory exists before publication"
  fi
  _assert_file "generation manifest: is a regular file" "$manifest"
  _assert_eq "generation manifest: protects desired state" 600 \
    "$(file_mode "$manifest")"
  _assert_contains "generation manifest: binds its stable nonce" \
    $'generation\t'"${generation##*/}" "$before"
  _assert_contains "generation manifest: preserves resolved records" \
    $'set\tweb\thost\tshell.example.com' "$before"
  if [[ $digest =~ ^[0-9a-f]{64}$ ]]; then
    _pass "generation manifest: has a portable SHA-256 digest"
  else
    _fail "generation manifest: has a portable SHA-256 digest"
  fi

  # The source is desired-state input, not generation state. Later edits must
  # not change the stable file that drivers and pointers authenticate.
  printf '%s\n' $'set\tweb\thost\tchanged.example.com' >>"$source"
  after=$(<"$manifest")
  _assert_eq "generation manifest: source changes cannot alter snapshot" \
    "$before" "$after"
  _assert_eq "generation manifest: digest remains bound to snapshot" \
    "$digest" "$(fwdports_generation_manifest_digest "$generation")"

  generation2=$(fwdports_generation_create "$root" "$source")
  _assert_ne "generation manifest: each start gets a distinct final path" \
    "$generation" "$generation2"
}


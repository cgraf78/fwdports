replacement_race_case() {
  local tmp anchor source destination fake_bin error status real_cp
  tmp=$(_tmpdir) || return 1
  anchor="$tmp/config"
  source="$anchor/driver"
  destination="$tmp/snapshot"
  fake_bin="$tmp/bin"
  error="$tmp/error"
  mkdir -p "$anchor" "$fake_bin"
  chmod 0700 "$anchor"
  printf '#!/usr/bin/env bash\nexit 0\n' >"$source"
  chmod 0700 "$source"
  real_cp=$(command -v cp) || return 1
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    '"$REAL_CP" "$@"' \
    'printf "# replaced\\n" >>"$1"' >"$fake_bin/cp"
  chmod 0700 "$fake_bin/cp"

  set +e
  PATH="$fake_bin:$PATH" REAL_CP=$real_cp \
    fwdports_snapshot_trusted_file "$source" "$destination" "$anchor" \
    2>"$error"
  status=$?

  _assert_exit "path trust: replacement during copy is rejected" 1 "$status"
  _assert_contains "path trust: replacement race is actionable" \
    "changed while being copied" "$(<"$error")"
  _assert_not_exists "path trust: replacement race publishes no snapshot" \
    "$destination"
}

atomic_owner_lock_case() {
  local tmp home state root candidate error status content
  tmp=$(_tmpdir) || return 1
  home="$tmp/home"
  state="$tmp/state"
  error="$tmp/error"
  mkdir -p "$home" "$state"
  chmod 0700 "$home" "$state"
  root=$(HOME=$home XDG_STATE_HOME=$state fwdports_runtime_init)

  set +e
  candidate=$(fwdports_lock_acquire "$root" 2>"$error")
  status=$?
  content=
  [[ -f "$root/lifecycle.lock" ]] && content=$(<"$root/lifecycle.lock")

  _assert_exit "owner lock: acquisition succeeds" 0 "$status"
  _assert_file "owner lock: candidate is a complete regular file" "$candidate"
  if [[ -L "$root/lifecycle.lock" ]]; then
    _pass "owner lock: fixed lock is an atomic symbolic pointer"
  else
    _fail "owner lock: fixed lock is an atomic symbolic pointer"
  fi
  if [[ $(readlink "$root/lifecycle.lock" 2>/dev/null) == "lock-candidates/${candidate##*/}" ]]; then
    _pass "owner lock: fixed pointer names the exact candidate"
  else
    _fail "owner lock: fixed pointer names the exact candidate"
  fi
  _assert_contains "owner lock: records current pid" $'pid\t'"$$" "$content"
  _assert_contains "owner lock: records process start identity" \
    $'start\t' "$content"
  _assert_contains "owner lock: records random nonce" $'nonce\t' "$content"
  _assert_eq "owner lock: protects owner record" 600 \
    "$(file_mode "$candidate")"

  fwdports_lock_release "$root" "$candidate"
  _assert_not_exists "owner lock: release removes fixed link" \
    "$root/lifecycle.lock"
  _assert_not_exists "owner lock: release removes candidate" "$candidate"
}


  status=$?

  _assert_exit "tampered pointer: digest mismatch is rejected" 1 "$status"
  _assert_eq "tampered pointer: yields no generation authority" \
    "" "$(<"$output")"
  _assert_contains "tampered pointer: diagnostic names manifest mismatch" \
    "manifest digest does not match" "$(<"$error")"
  _assert_file "tampered pointer: evidence is retained for diagnosis" \
    "$pointer"
}

pointer_replacement_case() {
  local tmp fixture root generation digest old_bytes second_source second
  local second_digest fake_bin error status leftovers
  tmp=$(_tmpdir) || return 1
  fixture=$(pointer_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  fwdports_pointer_publish "$root" pending "$generation" "$digest"
  old_bytes=$(<"$root/pending")

  second_source=$tmp/second-profile
  printf '%s\n' \
    $'version\t1' \
    $'profile\tother' \
    $'leg\tdb\tssh' \
    $'set\tdb\thost\tdb.example.com' \
    $'set\tdb\tremote-forward\t127.0.0.1:9090:127.0.0.1:90' \
    >"$second_source"
  chmod 0600 "$second_source"
  second=$(fwdports_generation_create "$root" "$second_source")
  second_digest=$(fwdports_generation_manifest_digest "$second")
  fwdports_control_write "$second" "$second_digest" preparing running \
    none none unknown

  fake_bin=$tmp/bin
  error=$tmp/error
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'printf "%s\n" "simulated pointer rename failure" >&2' \
    'exit 99' >"$fake_bin/mv"
  chmod 0700 "$fake_bin/mv"
  set +e
  PATH="$fake_bin:/usr/bin:/bin" \
    fwdports_pointer_publish "$root" pending "$second" "$second_digest" \
    2>"$error"
  status=$?
  leftovers=$(compgen -G "$root/.pending.*" || true)

  _assert_exit "pointer replacement: rename failure is reported" 1 "$status"
  _assert_eq "pointer replacement: old publication survives failure" \
    "$old_bytes" "$(<"$root/pending")"
  _assert_eq "pointer replacement: failed temporary file is removed" \
    "" "$leftovers"
  _assert_contains "pointer replacement: underlying failure is visible" \
    "simulated pointer rename failure" "$(<"$error")"
}

cleanup_boundary_case() {
  local tmp fixture root generation digest outside root_sentinel sibling
  local dangling status error
  tmp=$(_tmpdir) || return 1
  fixture=$(pointer_fixture "$tmp") || return 1
  IFS=$'\t' read -r root generation digest <<<"$fixture"
  outside=$tmp/outside-sentinel
  root_sentinel=$root/root-sentinel
  sibling=$root/generations/generation.sibling00
  dangling=$tmp/missing-target
  error=$tmp/error
  printf '%s\n' outside >"$outside"
  printf '%s\n' root >"$root_sentinel"
  mkdir -p "$sibling" "$generation/links"
  chmod 0700 "$sibling" "$generation/links"
  printf '%s\n' sibling >"$sibling/sentinel"
  ln -s "$outside" "$generation/links/outside"
  ln -s "$dangling" "$generation/links/dangling"
  fwdports_pointer_publish "$root" pending "$generation" "$digest"
  fwdports_pointer_remove "$root" pending "$generation" "$digest"

  set +e
  fwdports_generation_remove "$root" "$generation" "$digest" 2>"$error"
  status=$?

  _assert_exit "cleanup boundary: authenticated generation removal succeeds" \
    0 "$status"
  _assert_not_exists "cleanup boundary: removes only target generation" \
    "$generation"
  _assert_file "cleanup boundary: preserves outside symlink target" "$outside"
  _assert_file "cleanup boundary: preserves runtime-root sibling" "$root_sentinel"
  _assert_file "cleanup boundary: preserves generation-shaped sibling" \
    "$sibling/sentinel"
  _assert_not_exists "cleanup boundary: follows no dangling target" "$dangling"
  _assert_eq "cleanup boundary: emits no diagnostic" "" "$(<"$error")"
}


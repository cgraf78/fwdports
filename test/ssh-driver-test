retry_gate_case() {
  local tmp fake_ssh config_source launch_log argv_file identity digest
  local gate_dir error status before after marker
  tmp=$(_tmpdir) || return 1
  fake_ssh="$tmp/ssh"
  config_source="$tmp/effective"
  launch_log="$tmp/launch-log"
  argv_file="$tmp/argv"
  identity="$tmp/identity"
  digest="$tmp/digest"
  gate_dir="$tmp/generation"
  error="$tmp/error"
  printf '%s\n' 'hostname shell.example.com' 'user example' >"$config_source"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'if [[ ${1:-} == -V ]]; then' \
    "  printf '%s\\n' 'OpenSSH_9.9p1' >&2" \
    '  exit 0' \
    'fi' \
    'if [[ ${1:-} == -G ]]; then' \
    '  cat "$FWDPORTS_TEST_EFFECTIVE_CONFIG"' \
    '  exit 0' \
    'fi' \
    'printf "%s\\n" "$*" >>"$FWDPORTS_TEST_LAUNCH_LOG"' \
    'exit 0' >"$fake_ssh"
  chmod 0755 "$fake_ssh"
  printf '%s\n' '-N' '-T' >"$argv_file"
  FWDPORTS_TEST_EFFECTIVE_CONFIG=$config_source \
    fwdports_ssh_resolve "$fake_ssh" "$identity"
  FWDPORTS_TEST_EFFECTIVE_CONFIG=$config_source \
    fwdports_ssh_effective_digest "$fake_ssh" shell.example.com \
    "$argv_file" "$digest"

  set +e
  fwdports_ssh_prepare_gate "$gate_dir" "$identity" "$digest" 2>"$error"
  status=$?
  _assert_exit "ssh retry gate: generation gate is prepared" 0 "$status"

  FWDPORTS_TEST_EFFECTIVE_CONFIG=$config_source \
    FWDPORTS_TEST_LAUNCH_LOG=$launch_log \
    "$gate_dir/ssh-gate" -N -T shell.example.com
  status=$?
  _assert_exit "ssh retry gate: matching generation launches" 0 "$status"
  before=$(<"$launch_log")

  printf '%s\n' 'hostname changed.example.com' 'user example' >"$config_source"
  FWDPORTS_TEST_EFFECTIVE_CONFIG=$config_source \
    FWDPORTS_TEST_LAUNCH_LOG=$launch_log \
    "$gate_dir/ssh-gate" -N -T shell.example.com 2>"$error"
  status=$?
  after=$(<"$launch_log")
  marker=
  [[ -f "$gate_dir/ssh-drift" ]] && marker=$(<"$gate_dir/ssh-drift")
  _assert_exit "ssh retry gate: config drift refuses launch" 78 "$status"
  _assert_eq "ssh retry gate: drift launches no transport" "$before" "$after"
  _assert_eq "ssh retry gate: private marker names drift class" \
    "ssh-config-drift" "$marker"
  _assert_not_contains "ssh retry gate: marker contains no raw config" \
    "changed.example.com" "$marker"
}

local_port_conflict_case() {
  local tmp port_file listener port manifest argv_file target_file error
  local status diagnostic index=0 alive=0
  tmp=$(_tmpdir) || return 1
  port_file="$tmp/port"
  manifest="$tmp/manifest"
  argv_file="$tmp/argv"
  target_file="$tmp/target"
  error="$tmp/error"
  python3 - "$port_file" <<'PY' &
import socket
import signal
import sys
import time

signal.alarm(15)
listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
listener.bind(("127.0.0.1", 0))
listener.listen(1)
with open(sys.argv[1], "w", encoding="ascii") as output:
    output.write(str(listener.getsockname()[1]))
while True:
    time.sleep(1)
PY
  listener=$!
  while [[ ! -s "$port_file" && $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  port=$(<"$port_file")
  printf '%s\n' \
    $'version\t1' \
    $'profile\tdemo' \
    $'leg\tweb\tssh' \
    $'set\tweb\thost\tshell.example.com' \
    "set"$'\t'"web"$'\t'"local-forward"$'\t'"127.0.0.1:$port:127.0.0.1:80" \
    >"$manifest"
  fwdports_ssh_build_argv "$manifest" web '' "$argv_file" "$target_file"

  set +e
  fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error"
  status=$?
  diagnostic=$(<"$error")
  if kill -0 "$listener" 2>/dev/null; then
    alive=1
  fi
  kill "$listener" 2>/dev/null || true
  wait "$listener" 2>/dev/null || true

  _assert_exit "local port conflict: occupied port is rejected" 1 "$status"
  _assert_contains "local port conflict: diagnostic names port" \
    "$port" "$diagnostic"
  _assert_contains "local port conflict: diagnostic identifies inspection" \
    "listener details" "$diagnostic"
  _assert_eq "local port conflict: owner is not signalled" 1 "$alive"
}


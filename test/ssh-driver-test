# Writes fake ss/lsof/nc inspectors into $1. ss logs its argv when
# FWDPORTS_TEST_SS_LOG is set and follows FWDPORTS_TEST_SS (listener, empty,
# owners-fail, or fail). Its owner line lists processes sharing one socket,
# repeated on an IPv6 line like a prefork server, plus one whose comm tries to
# smuggle pid=1 into the line. lsof and nc record that they ran so cases can
# prove which inspector decided.
write_port_inspectors() {
  local fake_bin=$1
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    '[[ -z ${FWDPORTS_TEST_SS_LOG:-} ]] || printf "%s\n" "$*" >>"$FWDPORTS_TEST_SS_LOG"' \
    'case ${FWDPORTS_TEST_SS:-listener} in' \
    '  fail) exit 1 ;;' \
    '  empty) exit 0 ;;' \
    '  owners-fail) [[ " $* " != *" -p "* ]] || exit 1 ;;' \
    'esac' \
    'case " $* " in' \
    '  *" -p "*)' \
    '    printf "LISTEN 0 1 127.0.0.1:8080 0.0.0.0:* users:((\"fixture\",pid=4243,fd=3),(\"fixture\",pid=4242,fd=3),(\"a\",pid=1,fd=3\",pid=4244,fd=5))\n"' \
    '    printf "LISTEN 0 1 [::1]:8080 [::]:* users:((\"fixture\",pid=4242,fd=4))\n" ;;' \
    '  *) printf "LISTEN 0 1 127.0.0.1:8080 0.0.0.0:*\n" ;;' \
    'esac' >"$fake_bin/ss"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    ': >"$FWDPORTS_TEST_LSOF_MARKER"' \
    'case " $* " in' \
    '  *" -t "*) printf "777\n" ;;' \
    '  *) printf "fixture 777 user 3u IPv4 TCP 127.0.0.1:8080 (LISTEN)\n" ;;' \
    'esac' >"$fake_bin/lsof"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    ': >"$FWDPORTS_TEST_NC_MARKER"' \
    'exit "${FWDPORTS_TEST_NC_STATUS:-1}"' >"$fake_bin/nc"
  chmod 0755 "$fake_bin/ss" "$fake_bin/lsof" "$fake_bin/nc"
}

ss_listener_preferred_case() {
  local tmp fake_bin argv_file error status pids
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  argv_file=$tmp/argv
  error=$tmp/error
  write_port_inspectors "$fake_bin"
  printf '%s\n' '-L' '127.0.0.1:8080:127.0.0.1:80' >"$argv_file"

  set +e
  PATH="$fake_bin:$PATH" FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    FWDPORTS_TEST_NC_MARKER=$tmp/nc-ran \
    fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error"
  status=$?
  set -e
  _assert_exit "ss inspector: occupied port is rejected" 1 "$status"
  _assert_contains "ss inspector: diagnostic identifies ss" \
    "listener details (ss)" "$(<"$error")"
  _assert_contains "ss inspector: diagnostic carries the owner" \
    "pid=4242" "$(<"$error")"
  _assert_not_exists "ss inspector: preflight does not run lsof" \
    "$tmp/lsof-ran"

  # Owner columns are best-effort; the listener line itself must survive.
  set +e
  PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS=owners-fail \
    FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    FWDPORTS_TEST_NC_MARKER=$tmp/nc-ran \
    fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error"
  status=$?
  set -e
  _assert_exit "ss inspector: owner lookup failure still rejects" 1 "$status"
  _assert_contains "ss inspector: owner lookup failure keeps the listener" \
    "LISTEN 0 1 127.0.0.1:8080" "$(<"$error")"

  pids=$(PATH="$fake_bin:$PATH" FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    _fwdports_local_forward_listener_pids 8080)
  _assert_eq "ss inspector: every PID sharing the socket is reported once" \
    $'4243\n4242\n4244' "$pids"
  _assert_not_exists "ss inspector: PID lookup does not run lsof" \
    "$tmp/lsof-ran"
}

ss_leading_zero_port_case() {
  local tmp fake_bin argv_file error ss_log
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  argv_file=$tmp/argv
  error=$tmp/error
  ss_log=$tmp/ss.log
  write_port_inspectors "$fake_bin"
  # SSH accepts a zero-padded port; ss would read "02020" as octal 1040.
  printf '%s\n' '-L' '02020:127.0.0.1:80' >"$argv_file"

  PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS=empty FWDPORTS_TEST_SS_LOG=$ss_log \
    FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    FWDPORTS_TEST_NC_MARKER=$tmp/nc-ran \
    fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error" || true
  _assert_eq "ss inspector: preflight queries the decimal port" \
    "-H -ltn sport = :2020" "$(<"$ss_log")"

  : >"$ss_log"
  PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS_LOG=$ss_log \
    _fwdports_local_forward_listener_pids 02020 >/dev/null
  _assert_eq "ss inspector: PID lookup queries the decimal port" \
    $'-H -ltn sport = :2020\n-H -ltn -p sport = :2020' "$(<"$ss_log")"
}

proc_leading_zero_port_case() {
  local tmp port_file port listener listener_pid index=0 pids
  if [[ ! -r /proc/net/tcp ]]; then
    _pass "proc inspector: zero-padded port skipped (no /proc/net/tcp)"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  port_file=$tmp/port
  python3 - "$port_file" <<'PY' &
import os
import socket
import signal
import sys
import time

signal.alarm(15)
listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
listener.bind(("127.0.0.1", 0))
listener.listen(1)
with open(sys.argv[1] + ".tmp", "w", encoding="ascii") as output:
    output.write(f"{listener.getsockname()[1]} {os.getpid()}")
os.replace(sys.argv[1] + ".tmp", sys.argv[1])
while True:
    time.sleep(1)
PY
  listener=$!
  while [[ ! -s "$port_file" && $index -lt 200 ]]; do
    sleep 0.01
    index=$((index + 1))
  done
  # An interpreter launcher may fork, so the listener reports its own PID.
  read -r port listener_pid <"$port_file"
  # The /proc phase matches the hex port in /proc/net/tcp. A zero-padded spec
  # must still name this decimal port rather than its octal reading. Calibrate
  # first: Android can report /proc/net/tcp readable yet deny the read.
  if [[ $(_fwdports_local_forward_listener_pids_proc "$port") != "$listener_pid" ]]; then
    kill "$listener" 2>/dev/null || true
    wait "$listener" 2>/dev/null || true
    _pass "proc inspector: zero-padded port skipped (/proc cannot see owners)"
    return 0
  fi
  pids=$(_fwdports_local_forward_listener_pids_proc "0$port")
  kill "$listener" 2>/dev/null || true
  wait "$listener" 2>/dev/null || true
  _assert_eq "proc inspector: zero-padded port resolves as decimal" \
    "$listener_pid" "$pids"
}

ss_owner_non_utf8_comm_case() {
  local tmp fake_bin utf8_locale pids
  utf8_locale=$(locale -a 2>/dev/null | grep -iE '^(C|en_US)\.utf-?8$' | head -n 1)
  if [[ -z $utf8_locale ]]; then
    _pass "ss inspector: non-UTF-8 comm skipped (no UTF-8 locale)"
    return 0
  fi
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  mkdir -p "$fake_bin"
  # A UTF-8 regex `.` stops at an invalid byte, which would hide every owner
  # after a process whose name contains one.
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'case " $* " in *" -p "*) ;; *) printf "LISTEN 0 1 127.0.0.1:8080 0.0.0.0:*\n"; exit 0 ;; esac' \
    'printf "LISTEN 0 1 127.0.0.1:8080 0.0.0.0:* users:((\"a\",pid=11,fd=3),(\"\xff\",pid=22,fd=3),(\"c\",pid=33,fd=3))\n"' \
    >"$fake_bin/ss"
  chmod 0755 "$fake_bin/ss"
  pids=$(LC_ALL=$utf8_locale PATH="$fake_bin:$PATH" \
    _fwdports_local_forward_listener_pids 8080)
  _assert_eq "ss inspector: a non-UTF-8 comm hides no later owners" \
    $'11\n22\n33' "$pids"
}

ss_empty_case() {
  local tmp fake_bin argv_file error status pids
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  argv_file=$tmp/argv
  error=$tmp/error
  write_port_inspectors "$fake_bin"
  printf '%s\n' '-L' '127.0.0.1:8080:127.0.0.1:80' >"$argv_file"

  set +e
  PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS=empty \
    FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    FWDPORTS_TEST_NC_MARKER=$tmp/nc-ran FWDPORTS_TEST_NC_STATUS=1 \
    fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error"
  status=$?
  set -e
  _assert_exit "ss inspector: a free port passes preflight" 0 "$status"
  _assert_eq "ss inspector: a free port has no diagnostic" "" "$(<"$error")"
  _assert_file "ss inspector: an empty answer is confirmed by netcat" \
    "$tmp/nc-ran"
  _assert_not_exists "ss inspector: a free port does not run lsof" \
    "$tmp/lsof-ran"

  # A restricted /proc/net view can make ss report nothing for a live port.
  set +e
  PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS=empty \
    FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    FWDPORTS_TEST_NC_MARKER=$tmp/nc-ran FWDPORTS_TEST_NC_STATUS=0 \
    fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error"
  status=$?
  set -e
  _assert_exit "ss inspector: netcat catches a listener ss missed" 1 \
    "$status"
  _assert_contains "ss inspector: hidden-listener diagnostic names netcat" \
    "listener details (nc)" "$(<"$error")"

  pids=$(PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS=empty \
    FWDPORTS_TEST_SS_LOG=$tmp/ss.log \
    FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    _fwdports_local_forward_listener_pids 8080)
  _assert_eq "ss inspector: no listener yields no PIDs" "" "$pids"
  _assert_eq "ss inspector: a free port skips the owner scan" \
    "-H -ltn sport = :8080" "$(<"$tmp/ss.log")"
  _assert_not_exists "ss inspector: empty PID lookup does not run lsof" \
    "$tmp/lsof-ran"
}

ss_failure_fallback_case() {
  local tmp fake_bin only_ss_bin argv_file error status pids
  tmp=$(_tmpdir) || return 1
  fake_bin=$tmp/bin
  only_ss_bin=$tmp/only-ss
  argv_file=$tmp/argv
  error=$tmp/error
  write_port_inspectors "$fake_bin"
  printf '%s\n' '-L' '127.0.0.1:8080:127.0.0.1:80' >"$argv_file"

  set +e
  PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS=fail \
    FWDPORTS_TEST_SS_LOG=$tmp/ss.log \
    FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    FWDPORTS_TEST_NC_MARKER=$tmp/nc-ran \
    fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error"
  status=$?
  set -e
  _assert_file "ss failure: ss is consulted before lsof" "$tmp/ss.log"
  _assert_exit "ss failure: lsof still rejects an occupied port" 1 "$status"
  _assert_contains "ss failure: diagnostic identifies lsof" \
    "listener details (lsof)" "$(<"$error")"

  pids=$(PATH="$fake_bin:$PATH" FWDPORTS_TEST_SS=fail \
    FWDPORTS_TEST_LSOF_MARKER=$tmp/lsof-ran \
    _fwdports_local_forward_listener_pids 8080)
  _assert_eq "ss failure: listener PIDs fall back to lsof" "777" "$pids"

  # Only bash and the failing ss are visible, so no inspector can answer.
  mkdir -p "$only_ss_bin"
  ln -s "$BASH" "$only_ss_bin/bash"
  cp "$fake_bin/ss" "$only_ss_bin/ss"
  set +e
  PATH=$only_ss_bin FWDPORTS_TEST_SS=fail \
    fwdports_ssh_preflight_local_ports "$argv_file" 2>"$error"
  status=$?
  set -e
  _assert_exit "ss failure without lsof: preflight fails closed" 1 "$status"
  _assert_contains "ss failure without lsof: diagnostic names ss" \
    "ss failed while checking local port 8080" "$(<"$error")"

  set +e
  PATH=$only_ss_bin FWDPORTS_TEST_SS=fail \
    _fwdports_local_forward_listener_pids 8080 2>"$error"
  status=$?
  set -e
  _assert_exit "ss failure without lsof: PID lookup fails" 1 "$status"
  _assert_contains "ss failure without lsof: PID diagnostic keeps ss status" \
    "ss failed while inspecting port 8080 (exit 1)" "$(<"$error")"
}

duplicate_profile_local_ports_case() {
  local tmp manifest error status
  tmp=$(_tmpdir) || return 1
  manifest=$tmp/manifest
  error=$tmp/error
  printf '%s\n' \
    $'version\t1' \
    $'generation\tgeneration.test' \
    $'target\tnone' \
    $'profile\tdemo' \
    $'leg\texternal\texample' \
    >"$manifest"
  status=0
  fwdports_builtin_validate_profile_ports "$manifest" 2>"$error" ||
    status=$?
  _assert_exit "profile local ports: external-only profile is unaffected" \
    0 "$status"

  printf '%s\n' \
    $'version\t1' \
    $'generation\tgeneration.test' \
    $'target\tnone' \
    $'profile\tdemo' \
    $'leg\tfirst\tssh' \
    $'leg\tsecond\tautossh' \
    $'set\tfirst\tlocal-forward\t127.0.0.1:8080:127.0.0.1:80' \
    $'set\tsecond\tlocal-forward\t127.0.0.1:8080:127.0.0.1:81' \
    >"$manifest"

  set +e
  fwdports_builtin_validate_profile_ports "$manifest" 2>"$error"
  status=$?
  set -e

  _assert_exit "profile local ports: SSH-family duplicate is rejected" \
    1 "$status"
  _assert_contains "profile local ports: SSH-family diagnostic names duplicate" \
    "local forward port 8080 is claimed more than once" "$(<"$error")"

  sed $'s/second\tautossh/second\tet/' "$manifest" >"$tmp/et-manifest"
  set +e
  fwdports_builtin_validate_profile_ports "$tmp/et-manifest" 2>"$error"
  status=$?
  set -e
  _assert_exit "profile local ports: SSH/ET duplicate is rejected" 1 \
    "$status"
  _assert_contains "profile local ports: SSH/ET diagnostic names duplicate" \
    "local forward port 8080 is claimed more than once" "$(<"$error")"

  sed $'s/second\tautossh/second\tettun/' "$manifest" \
    >"$tmp/ettun-manifest"
  set +e
  fwdports_builtin_validate_profile_ports "$tmp/ettun-manifest" 2>"$error"
  status=$?
  set -e
  _assert_exit "profile local ports: SSH/ettun duplicate is rejected" 1 \
    "$status"
  _assert_contains "profile local ports: SSH/ettun diagnostic names duplicate" \
    "local forward port 8080 is claimed more than once" "$(<"$error")"
}


resolve_executable_case() {
  local tmp fake_bin output error status content
  tmp=$(_tmpdir) || return 1
  fake_bin="$tmp/bin"
  output="$tmp/identity"
  error="$tmp/error"
  mkdir -p "$fake_bin"
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'if [[ ${1:-} == -V ]]; then' \
    "  printf '%s\\n' 'OpenSSH_9.9p1, test crypto' >&2" \
    '  exit 0' \
    'fi' \
    'exit 0' >"$fake_bin/ssh"
  chmod 0755 "$fake_bin/ssh"

  set +e
  PATH="$fake_bin:/usr/bin:/bin" \
    fwdports_ssh_resolve ssh "$output" 2>"$error"
  status=$?
  content=
  [[ -f "$output" ]] && content=$(<"$output")

  _assert_exit "ssh executable: resolves" 0 "$status"
  _assert_contains "ssh executable: records canonical path" \
    $'path\t'"$fake_bin/ssh" "$content"
  _assert_contains "ssh executable: records OpenSSH version" \
    $'version\tOpenSSH_9.9p1' "$content"
  _assert_contains "ssh executable: records file identity" \
    $'identity\t' "$content"
  _assert_eq "ssh executable: no diagnostics" "" "$(<"$error")"
}

untrusted_executable_parent_case() {
